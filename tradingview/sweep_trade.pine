//@version=6
// =====================================================================
//  Sweep Trade (SMT)  (v4.2)
//  ---------------------------------------------------------------
//  NYT I v4.2 (9/10-26)
//    - EQ FOER OPEN ramt i entry-minuttet goer IKKE laengere tradet ugyldigt
//      (testet paa 2023-2026: reglen var overfit paa 2026). EQ'en bruges stadig
//      som BE, saa laenge den ikke er ramt. Kan slaas til igen under BE-indstillinger.
//  NYT I v4.1 (samme regler som backtesten, oktober 2026)
//    - TID CLOSE: entry kun paa den 15s-candle der foerst tager niveauet
//      eller den naeste. 3. candle eller senere = intet trade.
//    - EQ FOER OPEN vokser videre efter open og stopper paa den candle der
//      rammer EQ-linjen. Candlens forloeb (groen O-L-H-C / roed O-H-L-C) afgoer
//      om det er den gamle eller den flyttede linje der tjekkes.
//      Er der ingen live EQ ved open, bruges 15:29-candlens EQ.
//    - SAMLET NIVEAU: er en London/Asia high/low samlet med en senere
//      session paa bare eet af indeksene, bruges den ikke som eget niveau
//      (kun det samlede, fx NY PRE high). (9/4-26)
//    - Max 2 trades pr. dag, og stop for dagen efter en vundet trade (TP).
//  ---------------------------------------------------------------
//  NYT I v4.0
//    - Alle live EQ'er nulstilles ved market open, ligesom EQ-indikatoren.
//      15:29-candlen giver ikke en ny EQ efter open.
//      Saa kan der dannes nye EQ'er efter open (til BE). EQ'en der stod
//      lige foer open bruges stadig som 'EQ foer open'.
//  ---------------------------------------------------------------
//  NYT I v3.9
//    - Tager et indeks en tidligere sessions high/low i en senere session
//      (fx London low i NY PRE), er niveauet ikke brugt. Det flytter med
//      til den nye high/low ('NY PRE + London'). London low er stadig
//      gyldig for det andet indeks - indtil det tager det samlede niveau.
//    - Taget gaelder kun inden for en session, ikke for flyttede niveauer.
//  ---------------------------------------------------------------
//  NYT I v3.8
//    - Kun eet trade pr. minut. Kommer der et nyt signal i samme minut
//      (fx et 15m high lige efter NY PRE high), afloeser det ikke det foerste.
//  ---------------------------------------------------------------
//  NYT I v3.7
//    - EQ / session liq taget i entry-minuttet goer kun tradet ugyldigt
//      hvis niveauet ligger paa BE-siden af entry. Ligger det allerede
//      bag entry (fx en bearish EQ under en long-entry), staar tradet.
//  ---------------------------------------------------------------
//  NYT I v3.6
//    - 'EQ foer open ramt' taeller kun paa BE-siden (short: bullish EQ
//      under prisen, long: bearish EQ over).
//    - Session liq der er taget FOER open er ikke BE-kandidat (og goer
//      ikke tradet ugyldigt). Taget i vinduet foer entry -> ugyldigt.
//  ---------------------------------------------------------------
//  NYT I v3.5
//    - Alle tider regnes i New York-tid (open 09:30 NY). Foer stod de
//      fast i dansk tid, saa scriptet ramte forkert i ugerne i marts og
//      okt/nov hvor USA og Europa skifter sommertid paa hver sin dato
//      (der er open 14:30 dansk). Tiderne i boksen vises i dansk tid.
//  ---------------------------------------------------------------
//  NYT I v3.4
//    - Taget regnes paa 15m-candles: laver begge indeks deres session
//      high/low i SAMME 15m-candle, er der ingen Taget. Ellers er Taget
//      det andet indeks' high/low i den 15m-candle.
//    - EQ ramt: en bar tjekkes mod EQ-linjen FOER barens egen low/high
//      flytter den (ellers kan en bar 'ramme' en linje den selv flyttede).
//  ---------------------------------------------------------------
//  NYT I v3.3
//    - EQ / session liq taget i entry-minuttet goer kun tradet ugyldigt
//      hvis det sker FOER entry-candlen. Rammes det af selve
//      entry-candlen, er det tradets eget move - tradet staar.
//  ---------------------------------------------------------------
//  NYT I v3.2
//    - EQ foer open: kun en EQ der stadig er LIVE ved 15:30. Er alle
//      EQ'er brugt foer open, er der ingen EQ foer open.
//  ---------------------------------------------------------------
//  NYT I v3.1
//    - Ugyldigt hvis liq i trade-retningen er taget i entry-minuttet
//      foer (eller paa) entry-candlen:
//        LONG : en bearish EQ (live eller fra foer open) eller et
//               session high paa chartet er taget.
//        SHORT: en bullish EQ eller et session low er taget.
//  ---------------------------------------------------------------
//  NYT I v3.0
//    - "Taget"-regel: laver det ene indeks sin session high/low (equal
//      taeller med), og det andet ikke goer, gemmes det andet indeks'
//      high/low i samme 15m-candle som "Taget" (v3.4: 15m, ikke 1m). Sweeper det ene indeks
//      sit niveau og det andet sin Taget i vinduet, har begge taget den
//      samme high/low -> ikke SMT. Kan slaas fra under "Sessioner".
//  ---------------------------------------------------------------
//  NYT I v2.9
//    - "Begge sider samme minut" goer kun et trade ugyldigt hvis den
//      anden side er taget FOER eller I entry-candlen. Bliver den anden
//      side taget efter entry (fx prisen loeber mod TP), staar tradet.
//      Der kan bare ikke komme flere trades i det minut.
//  ---------------------------------------------------------------
//  NYT I v2.8
//    - 3-6-9: SMT kun i minutter med tvaersum 3, 6 eller 9
//      (15:30, 33, 36, 42, 45, 51, 54). Sweep i andre minutter giver
//      ingen SMT paa det niveau. Kan slaas fra under "Vindue".
//  ---------------------------------------------------------------
//  NYT I v2.7
//    - BE-kandidat: EQ fra FOER market open (EQ-linjen paa den bullish og
//      bearish EQ der stod live lige foer 15:30 - en brugt EQ taeller ikke).
//    - EQ fra foer open kan kun bruges som BE, saa laenge den ikke er ramt
//      efter open. Rammes den i SAMME minut som entry (foer/paa entry-
//      candlen), er tradet UGYLDIGT ("BE allerede ramt").
//    - Session liq der skulle have vaeret BE, men allerede er taget foer
//      entry -> tradet er UGYLDIGT.
//  ---------------------------------------------------------------
//  NYT I v2.6
//    - SMT kraever DIVERGENS: kun det ene indeks maa have taget niveauet.
//      Har begge taget det, er det ikke SMT (det er Vergence) - boksen
//      viser "Ingen SMT - begge har taget ... (Vergence)".
//  ---------------------------------------------------------------
//  NYT I v2.5
//    - Position tegnes paa NQ: SL-felt (roed) og TP-felt (groen), som
//      TradingViews position-vaerktoej. Den del af feltet prisen har
//      vaeret i, bliver moerkere. Felterne vokser med tiden og stopper
//      ved SL / TP.
//    - Max SL-stregen (30p) gaar fra SMT-sweepet og frem til tradet.
//  ---------------------------------------------------------------
//  NYT I v2.4
//    - TP: det naermeste af EQ og session liq mellem 35 og 75 points.
//      Ligger intet inden for, er TP 75 points. TP-linjen tegnes kun paa NQ.
//    - SL = toppen (short) / bunden (long) af 1m-candlen ved entry - fast.
//    - Gul max SL-streg (30 points) som paa Vergence. Lukker 15s-candlen
//      paa forkert side af den, er SL over 30 og der er intet trade.
//  ---------------------------------------------------------------
//  NYT I v2.3
//    - SL (minuttets high/low, min 10p) og TP (naermeste session liq
//      mellem 3.5R og 7.5R, ellers 7.5R) foelges efter entry.
//    - Naar SL eller TP rammes, forsvinder boksen, og BE-linjen stopper
//      paa den candle hvor det skete.
//    - BE-linjen starter 5 min frem og vokser 1 min pr. minut tradet
//      er aabent. BE flytter SL til entry (tidligst efter 2 15s-closes).
//  ---------------------------------------------------------------
//  NYT I v2.2
//    - Stoerre boks (tekststoerrelse kan vaelges).
//    - "SMT"-labelen sidder oven paa entry-candlen (short) / under (long).
//    - BE i boksen viser kun HVILKET niveau (fx "0.75" eller "NY PRE low").
//
//  NYT I v2.1
//    - "Bloker resten af dagen" er SLAAET FRA som standard. Kun samme
//      minut goer et trade ugyldigt.
//    - Boksen viser en grund naar et sweep ikke blev til et trade:
//        "Close tilbage, men ikke begge samme vej"
//        "Blokeret - begge sider taget i dag" (hvis dags-reglen er til)
//
//  NYT I v2
//    - Ingen stor label laengere. Paa chartet staar kun en lille "SMT"
//      ved tradet. Detaljerne staar i en lille boks i hjoernet.
//    - Boksen viser "Mulighed for SMT" saa snart et niveau bliver swept,
//      og "SHORT"/"LONG" naar 15s-closet kommer.
//    - UGYLDIG: bliver der i samme minut taget baade en high-side og en
//      low-side (fx NQ tager et 15m high og ES et 15m low ved 15:30),
//      er alt i det minut ugyldigt og slettes.
//    - Begge indeks skal lukke samme vej (short: begge bearish).
//    - BE vises kun paa NQ-chartet. BE = den NAERMESTE af:
//        EQ (0.5) og 0.75 (short) / 0.25 (long)
//        Session liq (Asia / London / NY PRE) som chartet ikke har taget
//        NY PRE 15m-niveauer som chartet ikke har taget
//        NY PRE 5m-niveauer - KUN ved trades i 15:30-minuttet
//      BE skal ligge mellem beMin og beMax points fra entry.
//
//  REGLEN
//    1) Et af de to indeks sweeper et niveau (mindst 1 tick forbi):
//       Asia / London / NY PRE high/low eller et NY PRE 15m-niveau.
//    2) I SAMME MINUT kommer et 15s-close tilbage paa den anden side af
//       niveauet paa det indeks der sweepede, og begge indeks lukker i
//       trade-retningen:
//         high swept + close UNDER + begge bearish  -> SHORT
//         low  swept + close OVER  + begge bullish  -> LONG
//    Hvert niveau giver hoejst eet trade. Et niveau der allerede er
//    taget foer vinduet starter, taeller ikke.
//
//  Laeg den paa et 15s-chart.
// =====================================================================
indicator("Helbert's Hjælpe Indikator (Sweep Trade)", overlay = true,
     max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// ─────────────────────────── INPUTS ───────────────────────────
g1 = "Symboler"
cmpSym = input.symbol("CME_MINI:ES1!", "Sammenlign med", group = g1,
     tooltip = "Ligger du paa NQ, skal denne staa paa ES - og omvendt.")

g2 = "Sessioner (samme som Session Levels)"
// Alt regnes i New York-tid, saa market open altid er 09:30 NY - ogsaa i de
// uger hvor USA og Europa skifter sommertid paa forskellige datoer (saa er open 14:30 dansk).
tz       = input.string("America/New_York", "Tidszone (NY)", group = g2)
dispTz   = input.string("Europe/Copenhagen", "Tidszone til visning", group = g2)
asiaSess = input.session("2000-0200", "Asia (NY-tid)",   group = g2, tooltip = "= 02:00-08:00 dansk")
lonSess  = input.session("0200-0800", "London (NY-tid)", group = g2, tooltip = "= 08:00-14:00 dansk")
nySess   = input.session("0800-0930", "NY PRE (NY-tid)", group = g2, tooltip = "= 14:00-15:30 dansk")
useTaget = input.bool(true, "Taget-regel", group = g2,
     tooltip = "Laver det ene indeks sin session high/low og det andet ikke, er det andet indeks' 1m high/low i det minut 'Taget'. Tager det ene indeks sit niveau og det andet sin Taget, er det ikke SMT.")
useAsia  = input.bool(true, "Asia",   group = g2, inline = "s")
useLon   = input.bool(true, "London", group = g2, inline = "s")
useNy    = input.bool(true, "NY PRE", group = g2, inline = "s")
use15    = input.bool(true, "15m",    group = g2, inline = "s")

g3 = "Vindue"
openHour = input.int(9, "Start - time (NY)",  minval = 0, maxval = 23, group = g3)
openMin  = input.int(30, "Start - minut (NY)", minval = 0, maxval = 59, group = g3)
endHour  = input.int(10, "Slut - time NY (til, ikke med)",  minval = 0, maxval = 23, group = g3)
endMin   = input.int(0,  "Slut - minut NY (til, ikke med)", minval = 0, maxval = 59, group = g3)
m15H     = input.int(9, "15m-niveauer gaelder til - time (NY)",  minval = 0, maxval = 23, group = g3)
use369   = input.bool(true, "Kun paa 3-6-9 minutter", group = g3,
     tooltip = "SMT kun naar minuttets tvaersum er 3, 6 eller 9: 15:30, 33, 36, 42, 45, 51 og 54. Sweepet og entry skal ske i et af de minutter.")
m15M     = input.int(31, "15m-niveauer gaelder til - minut (NY)", minval = 0, maxval = 59, group = g3,
     tooltip = "Samme som 'Fjern igen' paa Session Levels. Default 15:31.")

g6 = "Regler"
needBoth  = input.bool(true, "Begge indeks skal lukke samme vej", group = g6)
tidClose  = input.int(2, "Tid close: entry senest paa candle nr. (0 = fra)", minval = 0, maxval = 4, group = g6,
     tooltip = "Taelles fra den 15s-candle der foerst tager niveauet. 2 = den candle eller den naeste.")
mergeEither = input.bool(true, "Samlet niveau paa eet indeks er ikke eget niveau", group = g6,
     tooltip = "Er London/Asia samlet med en senere session (fx NY PRE high) paa bare det ene indeks, tjekkes kun det samlede niveau.")
maxDay    = input.int(2, "Max trades pr. dag", minval = 0, group = g6)
stopWin   = input.bool(true, "Stop for dagen efter en vundet trade", group = g6)
dayBlock  = input.bool(false, "Bloker resten af dagen naar begge sider er taget", group = g6,
     tooltip = "Er der siden market open taget baade en high-side og en low-side (paa et af indeksene), kommer der ikke flere trades den dag. Signaler i SAMME minut som det skete slettes altid.")

g4 = "BE"
beSym   = input.string("NQ", "Vis BE kun paa symbol der indeholder", group = g4)
beMin   = input.float(2,  "BE mindst (points) fra entry", minval = 0, group = g4)
beMax   = input.float(50, "BE hoejst (points) fra entry", minval = 1, group = g4)

g7 = "SL / TP"
minSL  = input.float(10, "Minimum SL (points)", minval = 0, group = g7)
maxSL     = input.float(30, "Max SL (points) - 3R", minval = 1, group = g7,
     tooltip = "Maales fra toppen (short) / bunden (long) af det 1m-candle entry sker i. Er SL stoerre, er tradet ugyldigt.")
blockMax  = input.bool(true, "Ugyldigt trade hvis SL > max", group = g7)
showMaxLn = input.bool(true, "Tegn max SL-stregen", group = g7)
mxCol     = input.color(color.red, "Max SL-streg", group = g7)
mxKeepS  = input.int(15, "Max SL-stregen bliver staaende efter entry (sekunder)", minval = 0, maxval = 300, group = g7,
     tooltip = "Regnet fra entry-candlens close. 15 = hele den foelgende 15s-candle.")
mxAhead  = input.int(2, "Max SL-stregen raekker frem (minutter)", minval = 0, maxval = 15, group = g7,
     tooltip = "Stregen starter ved signalet og raekker saa mange minutter frem fra den aktuelle candle, saa den er let at se.")
tpMin  = input.float(35, "TP mindst (points)", minval = 0, group = g7)
tpMax  = input.float(75, "TP max / fallback (points)", minval = 1, group = g7,
     tooltip = "TP = det naermeste af EQ og session liq, der ligger mellem TP mindst og TP max fra entry. Ligger intet inden for, bruges TP max. SL = toppen (short) / bunden (long) af det 1m-candle entry sker i - fast, kun flyttet til entry ved BE.")
tpCol  = input.color(color.teal, "TP-linje", group = g7)
g8 = "Position (kun NQ)"
showPos  = input.bool(true, "Tegn position (SL + TP)", group = g8)
posSlCol = input.color(color.new(#F23645, 78), "SL-felt",            group = g8)
posSlHit = input.color(color.new(#F23645, 55), "SL-felt (prisen har vaeret der)", group = g8)
posTpCol = input.color(color.new(#089981, 78), "TP-felt",            group = g8)
posTpHit = input.color(color.new(#089981, 55), "TP-felt (prisen har vaeret der)", group = g8)
showPx   = input.bool(true, "Skriv prisen ved entry / SL / TP", group = g8)
pxCol    = input.color(color.gray, "Entry-pris", group = g8)
beEq    = input.bool(true, "EQ og 0.25 / 0.75",        group = g4)
beSess  = input.bool(true, "Session liq",              group = g4)
be15    = input.bool(true, "15m-niveauer",             group = g4)
be05    = input.bool(true, "5m-niveauer (kun 15:30)",  group = g4)
bePre   = input.bool(true, "EQ fra foer market open", group = g4,
     tooltip = "EQ-linjen (0.5) paa den bullish og bearish EQ der stod LIVE lige foer 15:30 (en EQ der allerede er brugt taeller ikke). Laases ved open og kan bruges som BE resten af vinduet.")
preInv  = input.bool(false, "EQ foer open ramt = ugyldigt trade", group = g4,
     tooltip = "Fra som standard (9/10-26). Til = er EQ foer open paa BE-siden ramt i entry-minuttet, er tradet ugyldigt (gammel regel).")

g5 = "Visning"
shortCol = input.color(color.red,    "Short", group = g5)
longCol  = input.color(color.lime,   "Long",  group = g5)
beCol    = input.color(color.orange, "BE-linje", group = g5)
beMins   = input.int(5, "BE-linjens start-laengde (minutter)", minval = 1, group = g5,
     tooltip = "Linjen vokser 1 minut for hvert minut tradet er aabent, og stopper der hvor SL eller TP bliver ramt.")
boxPosS  = input.string("Nederst hoejre", "Boksens placering",
     options = ["Nederst hoejre", "Nederst venstre", "Oeverst hoejre", "Oeverst venstre"], group = g5)
boxSizeS = input.string("Normal", "Boksens tekststoerrelse", options = ["Lille", "Normal", "Stor"], group = g5)
warn15s  = input.bool(true, "Advar hvis chartet ikke er 15s", group = g5)

boxSize = switch boxSizeS
    "Lille" => size.small
    "Stor"  => size.large
    => size.normal

boxPos = switch boxPosS
    "Nederst venstre" => position.bottom_left
    "Oeverst hoejre"  => position.top_right
    "Oeverst venstre" => position.top_left
    => position.bottom_right

// ───────── SAMMENLIGNINGSSYMBOLET ─────────
[bHigh, bLow, bOpen, bClose] = request.security(cmpSym, timeframe.period, [high, low, open, close],
     gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

string aName  = syminfo.ticker
string bName  = str.contains(cmpSym, ":") ? array.get(str.split(cmpSym, ":"), 1) : cmpSym
bool   showBE = str.contains(syminfo.ticker, beSym)   // BE / TP tegnes kun paa NQ

float tick     = syminfo.mintick
float tickHalf = tick / 2
int   minB     = int(time / 60000)

// ─────────────────── TID ───────────────────
int  tMin   = hour(time, tz) * 60 + minute(time, tz)
int  winS   = openHour * 60 + openMin
int  winE   = endHour  * 60 + endMin
bool inWin  = tMin >= winS and tMin < winE
bool isOpenM = tMin == winS
int  m15E   = m15H * 60 + m15M
int  dNow   = dayofmonth(time, tz)

// 3-6-9: minuttets tvaersum skal vaere 3, 6 eller 9 (30, 33, 36, 42, 45, 51, 54)
int  mn369 = minute(time, tz)
int  ds369 = int(mn369 / 10) + mn369 % 10
bool is369 = not use369 or ds369 == 3 or ds369 == 6 or ds369 == 9

// Minuttets high/low (til SL)
int  mnow = minute(time, tz)
var float m1Hi = na
var float m1Lo = na
bool newMin = mnow != mnow[1]
m1Hi := newMin ? high : math.max(nz(m1Hi, high), high)
m1Lo := newMin ? low  : math.min(nz(m1Lo, low),  low)
// Samme for det andet indeks (til Taget)
var float bm1Hi = na
var float bm1Lo = na
bm1Hi := na(bHigh) ? bm1Hi : newMin ? bHigh : math.max(nz(bm1Hi, bHigh), bHigh)
bm1Lo := na(bLow)  ? bm1Lo : newMin ? bLow  : math.min(nz(bm1Lo, bLow),  bLow)
// 15m-candlens high/low paa begge indeks (til Taget - samme som et 15m-chart)
int   q15B   = int(time / 900000)
bool  newQ15 = q15B != nz(q15B[1], -1)
var float aq15Hi = na
var float aq15Lo = na
var float bq15Hi = na
var float bq15Lo = na
aq15Hi := newQ15 ? high : math.max(nz(aq15Hi, high), high)
aq15Lo := newQ15 ? low  : math.min(nz(aq15Lo, low),  low)
bq15Hi := na(bHigh) ? bq15Hi : newQ15 ? bHigh : math.max(nz(bq15Hi, bHigh), bHigh)
bq15Lo := na(bLow)  ? bq15Lo : newQ15 ? bLow  : math.min(nz(bq15Lo, bLow),  bLow)

int  aT = time(timeframe.period, asiaSess, tz)
int  lT = time(timeframe.period, lonSess,  tz)
int  nT = time(timeframe.period, nySess,   tz)
bool aOn = not na(aT)
bool lOn = not na(lT)
bool nOn = not na(nT)
bool aStart = aOn and na(aT[1])
bool lStart = lOn and na(lT[1])
bool nStart = nOn and na(nT[1])

// ─────────────────────────── TYPER ───────────────────────────
// Status for EEN side (high eller low) af eet niveau paa begge indeks.
//   aM/bM       = minuttet hvor indekset sweepede (i vinduet)
//   aDone/bDone = brugt op (ingen trade mere herfra)
//   aTook       = chartets symbol har taget niveauet (kan ikke bruges som BE)
type St
    int  aM    = na
    int  bM    = na
    int  aT    = na      // tid for den foerste candle der tog niveauet (tid close)
    int  bT    = na
    bool aDone = false
    bool bDone = false
    bool aTook = false
    bool bTook = false   // sammenligningssymbolet har taget niveauet
    bool aTgT  = false   // chartets symbol har taget sin Taget (i vinduet)
    bool bTgT  = false   // det andet indeks har taget sin Taget (i vinduet)
    bool aPre  = false   // chartet tog niveauet FOER vinduet (saa er det ikke liq laengere)

type Sess
    float aHi = na
    float aLo = na
    float bHi = na
    float bLo = na
    St    hi  = na
    St    lo  = na
    // Taget: minuttet hvor hvert indeks sidst lavede sin high/low,
    // og det andet indeks' 1m high/low i det minut.
    int   aHiM = na
    int   bHiM = na
    int   aLoM = na
    int   bLoM = na
    float aTgH = na      // chartets Taget high (det andet lavede high)
    float bTgH = na
    float aTgL = na
    float bTgL = na
    // Taget i en senere session (foer open) -> niveauet flytter med (fx "NY PRE + London")
    bool  maHi = false   // chartets symbol
    bool  mbHi = false   // det andet indeks
    bool  maLo = false
    bool  mbLo = false

// Eet NY PRE 15m- eller 5m-niveau. a = chartets symbol, b = det andet.
type Lv
    float a    = na
    float b    = na
    bool  isHi = false
    bool  dead = false
    St    st   = na

// Hvad skete der paa denne bar?
type Hit
    bool   fired   = false
    bool   isShort = false
    float  lvl     = na
    string src     = ""
    string who     = ""
    bool   noDir   = false   // close tilbage, men ikke begge samme vej
    bool   slBad   = false   // close tilbage, men SL > max
    bool   swHi    = false   // et high-niveau blev swept i vinduet
    bool   swLo    = false   // et low-niveau blev swept i vinduet
    string swTxt   = ""
    bool   both    = false   // begge indeks har taget niveauet -> ikke SMT
    bool   sHi     = false   // chartet tog et session high i vinduet
    bool   sLo     = false   // chartet tog et session low i vinduet
    float  sHiV    = na      // hoejeste session high taget paa baren
    float  sLoV    = na      // laveste session low taget paa baren
    string bothTxt = ""

// ─────────────────────────── FUNKTIONER ───────────────────────────
build(Sess s, bool isStart) =>
    if isStart
        s.aHi := high
        s.aLo := low
        s.bHi := bHigh
        s.bLo := bLow
        s.hi  := St.new()
        s.lo  := St.new()
        s.aHiM := q15B
        s.bHiM := q15B
        s.aLoM := q15B
        s.bLoM := q15B
        s.aTgH := na
        s.bTgH := na
        s.aTgL := na
        s.bTgL := na
        s.maHi := false
        s.mbHi := false
        s.maLo := false
        s.mbLo := false
    else
        // Nyt (eller equal) session high/low -> husk 15m-candlen
        if high >= s.aHi
            s.aHiM := q15B
        if low <= s.aLo
            s.aLoM := q15B
        if not na(bHigh) and bHigh >= nz(s.bHi, bHigh)
            s.bHiM := q15B
        if not na(bLow) and bLow <= nz(s.bLo, bLow)
            s.bLoM := q15B
        s.aHi := math.max(s.aHi, high)
        s.aLo := math.min(s.aLo, low)
        s.bHi := na(bHigh) ? s.bHi : math.max(nz(s.bHi, bHigh), bHigh)
        s.bLo := na(bLow)  ? s.bLo : math.min(nz(s.bLo, bLow),  bLow)
    // Det andet indeks' high/low i den 15m-candle hvor indekset lavede sit niveau
    if s.aHiM == q15B
        s.bTgH := bq15Hi
    if s.bHiM == q15B
        s.aTgH := aq15Hi
    if s.aLoM == q15B
        s.bTgL := bq15Lo
    if s.bLoM == q15B
        s.aTgL := aq15Lo
    true

// Taget-niveauet for een side (na hvis begge lavede niveauet i samme 15m-candle)
tgA(Sess s, bool isHi) =>
    not useTaget or (isHi ? (s.maHi or s.mbHi) : (s.maLo or s.mbLo)) ? na : isHi ? (s.aHiM != s.bHiM ? s.aTgH : na) : (s.aLoM != s.bLoM ? s.aTgL : na)
tgB(Sess s, bool isHi) =>
    not useTaget or (isHi ? (s.maHi or s.mbHi) : (s.maLo or s.mbLo)) ? na : isHi ? (s.aHiM != s.bHiM ? s.bTgH : na) : (s.aLoM != s.bLoM ? s.bTgL : na)

// Tjek een side af eet niveau. aL/bL = niveauet paa hvert indeks.
check(St st, float aL, float bL, bool isHi, string nm, Hit h, float aTg = na, float bTg = na) =>
    if not na(st) and not na(aL) and not na(bL)
        bool aSweep = isHi ? high >= aL + tick : low <= aL - tick
        bool bSweep = isHi ? (not na(bHigh) and bHigh >= bL + tick) : (not na(bLow) and bLow <= bL - tick)
        string lvlNm = nm + (isHi ? " high" : " low")
        // Session high/low taget i vinduet (kun foerste gang - et allerede taget niveau taeller ikke)
        if inWin and aSweep and not st.aTook and nm != "15m"
            if isHi
                h.sHi  := true
                h.sHiV := na(h.sHiV) ? aL : math.max(h.sHiV, aL)
            else
                h.sLo  := true
                h.sLoV := na(h.sLoV) ? aL : math.min(h.sLoV, aL)
        if aSweep
            st.aTook := true
        if bSweep
            st.bTook := true
        // Taget: kun i vinduet, og kun naar den ligger foran det rigtige niveau
        bool newTg = false
        if inWin and not na(aTg) and (isHi ? aTg < aL and high >= aTg + tick : aTg > aL and low <= aTg - tick) and not st.aTgT
            st.aTgT := true
            newTg   := true
        if inWin and not na(bTg) and (isHi ? bTg < bL and not na(bHigh) and bHigh >= bTg + tick : bTg > bL and not na(bLow) and bLow <= bTg - tick) and not st.bTgT
            st.bTgT := true
            newTg   := true
        bool aTk = st.aTook or st.aTgT
        bool bTk = st.bTook or st.bTgT
        // Foer vinduet: et taget niveau er brugt op (ingen trade).
        if not inWin
            if aSweep
                st.aDone := true
                st.aPre  := true
            if bSweep
                st.bDone := true
        else
            bool newA = not st.aDone and na(st.aM) and aSweep
            bool newB = not st.bDone and na(st.bM) and bSweep
            if newA
                st.aM := minB
                st.aT := time
            if newB
                st.bM := minB
                st.bT := time
            if newA or newB
                h.swHi  := h.swHi or isHi
                h.swLo  := h.swLo or not isHi
            // Begge indeks har taget niveauet -> ingen divergens = ikke SMT (det er Vergence)
            if (newA or newB or newTg) and aTk and bTk and not (st.aDone and st.bDone)
                h.both    := true
                h.bothTxt := lvlNm + (st.aTook and st.bTook ? "" : " (Taget)")
                st.aDone  := true
                st.bDone  := true
            // Kun det ene indeks har taget det -> mulighed for SMT
            else if is369 and ((newA and not bTk) or (newB and not aTk))
                h.swTxt := lvlNm + " (" + (newA ? aName : bName) + ")"
            // Sweep uden for et 3-6-9-minut -> ingen SMT paa det niveau
            if not is369
                if newA
                    st.aDone := true
                if newB
                    st.bDone := true
            // Minuttet er gaaet uden close tilbage -> brugt op
            if not st.aDone and not na(st.aM) and st.aM != minB
                st.aDone := true
            if not st.bDone and not na(st.bM) and st.bM != minB
                st.bDone := true
            // 15s-close tilbage paa den anden side i samme minut
            if barstate.isconfirmed and not h.fired
                bool dirOK = not needBoth or (isHi
                     ? (close < open and not na(bClose) and bClose < bOpen)
                     : (close > open and not na(bClose) and bClose > bOpen))
                bool aBack = not st.aDone and not bTk and st.aM == minB and (isHi ? close < aL : close > aL)
                bool bBack = not st.bDone and not aTk and st.bM == minB and not na(bClose) and (isHi ? bClose < bL : bClose > bL)
                // Tid close: entry paa sweep-candlen eller de naeste tidClose-1 candles
                if tidClose > 0 and aBack and time - st.aT > 15000 * (tidClose - 1)
                    aBack := false
                if tidClose > 0 and bBack and time - st.bT > 15000 * (tidClose - 1)
                    bBack := false
                if not dirOK and (aBack or bBack)
                    h.noDir := true
                bool slOK = not blockMax or (isHi ? m1Hi - close <= maxSL : close - m1Lo <= maxSL)
                if dirOK and (aBack or bBack) and not slOK
                    h.slBad  := true
                    st.aDone := true
                    st.bDone := true
                if dirOK and (aBack or bBack) and slOK
                    h.fired   := true
                    h.isShort := isHi
                    h.lvl     := aL
                    h.src     := lvlNm
                    h.who     := aBack and bBack ? aName + " + " + bName : (aBack ? aName : bName)
                    st.aDone  := true
                    st.bDone  := true
    h.fired

// Gem et NY PRE-niveau (high + low) fra en lukket 15m/5m-candle.
pushLv(array<Lv> arr, float ah, float al, float bh, float bl) =>
    Lv h = Lv.new()
    h.a    := ah
    h.b    := bh
    h.isHi := true
    h.st   := St.new()
    array.push(arr, h)
    Lv l = Lv.new()
    l.a    := al
    l.b    := bl
    l.isHi := false
    l.st   := St.new()
    array.push(arr, l)

// Taget mens NY PRE koerer (paa et af indeksene) -> ugyldigt
killInNy(array<Lv> arr) =>
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            Lv m = array.get(arr, i)
            bool aHit = m.isHi ? high >= m.a : low <= m.a
            bool bHit = m.isHi ? (not na(bHigh) and bHigh >= m.b) : (not na(bLow) and bLow <= m.b)
            if aHit or bHit
                m.dead := true

// Bedste BE indtil videre.
type BeC
    float  v   = na
    string src = ""
    bool   bad = false   // den valgte BE er allerede ramt -> tradet er ugyldigt

// BE-kandidat: i profit-retningen, mellem beMin og beMax fra entry,
// og naermere end den hidtil bedste -> bliver den nye BE.
tryBE(BeC b, float px, bool isShort, float c, string nm) =>
    bool  dir = not na(c) and (isShort ? c < px : c > px)
    float d   = na(c) ? 0.0 : math.abs(px - c)
    if dir and d >= beMin and d <= beMax and (na(b.v) or d < math.abs(px - b.v))
        b.v   := c
        b.src := nm
        b.bad := false
    b.v

// Som tryBE, men for et niveau der kan vaere ramt foer entry
// (EQ fra foer open og session liq). Bliver det valgt og er det ramt,
// er tradet ugyldigt.
tryBEt(BeC b, float px, bool isShort, float c, string nm, bool taken) =>
    bool  dir = not na(c) and (isShort ? c < px : c > px)
    float d   = na(c) ? 0.0 : math.abs(px - c)
    if dir and d >= beMin and d <= beMax and (na(b.v) or d < math.abs(px - b.v))
        b.v   := c
        b.src := nm
        b.bad := taken
    b.v

// ─────────────────── SESSIONER ───────────────────
var Sess asia = Sess.new()
var Sess lon  = Sess.new()
var Sess ny   = Sess.new()

// Tager et indeks en tidligere sessions high/low i en senere session (foer open), er
// niveauet ikke brugt - det flytter med til den nye high/low (fx "NY PRE + London").
mergeSess(Sess s, bool on) =>
    if not on and tMin < winS and not na(s.aHi)
        if high > s.aHi
            s.aHi  := high
            s.maHi := true
        if low < s.aLo
            s.aLo  := low
            s.maLo := true
        if not na(bHigh) and not na(s.bHi) and bHigh > s.bHi
            s.bHi  := bHigh
            s.mbHi := true
        if not na(bLow) and not na(s.bLo) and bLow < s.bLo
            s.bLo  := bLow
            s.mbLo := true
    true

mergeSess(asia, aOn)
mergeSess(lon,  lOn)

if aOn
    build(asia, aStart)
if lOn
    build(lon, lStart)
if nOn
    build(ny, nStart)

// ─────────────────── NY PRE 15m- OG 5m-NIVEAUER ───────────────────
lvBar() =>
    [high[1], low[1], time[1]]

[qH, qL, qT] = request.security(syminfo.tickerid, "15", lvBar(), lookahead = barmerge.lookahead_on)
[eH, eL, eT] = request.security(cmpSym,           "15", lvBar(), lookahead = barmerge.lookahead_on)
[fH, fL, fT] = request.security(syminfo.tickerid, "5",  lvBar(), lookahead = barmerge.lookahead_on)
[gH, gL, gT] = request.security(cmpSym,           "5",  lvBar(), lookahead = barmerge.lookahead_on)

var int lastQt = na
bool newM15 = not na(qT) and qT != nz(lastQt, -1)
if newM15
    lastQt := qT
var int lastFt = na
bool newM05 = not na(fT) and fT != nz(lastFt, -1)
if newM05
    lastFt := fT

int nyFrom = int(str.tonumber(str.substring(nySess, 0, 2))) * 60 + int(str.tonumber(str.substring(nySess, 2, 4)))
inNyAt(int t) =>
    int m = na(t) ? na : hour(t, tz) * 60 + minute(t, tz)
    not na(m) and m >= nyFrom and m < winS

var array<Lv> lv15 = array.new<Lv>()
var array<Lv> lv05 = array.new<Lv>()
if nStart
    array.clear(lv15)
    array.clear(lv05)

if newM15 and inNyAt(qT) and not na(qH) and not na(eH)
    pushLv(lv15, qH, qL, eH, eL)
if newM05 and inNyAt(fT) and not na(fH) and not na(gH)
    pushLv(lv05, fH, fL, gH, gL)

if nOn
    killInNy(lv15)
    killInNy(lv05)

// 5m-niveauer bruges kun som BE - hold styr paa om chartet har taget dem.
if not nOn and array.size(lv05) > 0
    for i = 0 to array.size(lv05) - 1
        Lv m = array.get(lv05, i)
        if m.isHi ? high >= m.a : low <= m.a
            m.st.aTook := true
// 15m-niveauer efter 15:31 (tjekkes ikke laengere for SMT) - taget -> ikke BE-kandidat
if not nOn and tMin >= m15E and array.size(lv15) > 0
    for i = 0 to array.size(lv15) - 1
        Lv m = array.get(lv15, i)
        if m.isHi ? high >= m.a : low <= m.a
            m.st.aTook := true

// ─────────────────── TJEK ALLE NIVEAUER ───────────────────
Hit hit = Hit.new()

if useNy and not nOn
    check(ny.hi, ny.aHi, ny.bHi, true,  "NY PRE", hit, tgA(ny, true),  tgB(ny, true))
    check(ny.lo, ny.aLo, ny.bLo, false, "NY PRE", hit, tgA(ny, false), tgB(ny, false))
// Har et indeks (mergeEither) / begge indeks taget niveauet i en senere session, er det
// samme niveau som den senere sessions -> det tjekkes kun dér.
if useLon and not lOn
    if not (mergeEither ? (lon.maHi or lon.mbHi) : (lon.maHi and lon.mbHi))
        check(lon.hi, lon.aHi, lon.bHi, true,  "London", hit, tgA(lon, true),  tgB(lon, true))
    if not (mergeEither ? (lon.maLo or lon.mbLo) : (lon.maLo and lon.mbLo))
        check(lon.lo, lon.aLo, lon.bLo, false, "London", hit, tgA(lon, false), tgB(lon, false))
if useAsia and not aOn
    if not (mergeEither ? (asia.maHi or asia.mbHi) : (asia.maHi and asia.mbHi))
        check(asia.hi, asia.aHi, asia.bHi, true,  "Asia", hit, tgA(asia, true),  tgB(asia, true))
    if not (mergeEither ? (asia.maLo or asia.mbLo) : (asia.maLo and asia.mbLo))
        check(asia.lo, asia.aLo, asia.bLo, false, "Asia", hit, tgA(asia, false), tgB(asia, false))
if use15 and not nOn and tMin < m15E and array.size(lv15) > 0
    for i = 0 to array.size(lv15) - 1
        Lv m = array.get(lv15, i)
        // NY PRE's eget high/low er allerede tjekket ovenfor
        bool isExt = m.isHi ? math.abs(m.a - nz(ny.aHi)) < tickHalf : math.abs(m.a - nz(ny.aLo)) < tickHalf
        if not m.dead and not isExt
            check(m.st, m.a, m.b, m.isHi, "15m", hit)

// Minuttet hvor chartet sidst tog et session high / low i vinduet
var int sHiM = na
var int sLoM = na
var float sHiMx = na  // hoejeste session high taget i minuttet
var float sLoMn = na  // laveste session low taget i minuttet
// ... tidligere i minuttet, FOER denne bar (entry-candlen selv taeller ikke)
float sHiPrev = not na(sHiM) and sHiM == minB ? sHiMx : na
float sLoPrev = not na(sLoM) and sLoM == minB ? sLoMn : na
if hit.sHi
    sHiMx := nz(sHiM, -1) != minB ? hit.sHiV : math.max(sHiMx, hit.sHiV)
    sHiM  := minB
if hit.sLo
    sLoMn := nz(sLoM, -1) != minB ? hit.sLoV : math.min(sLoMn, hit.sLoV)
    sLoM  := minB

// ═════════════ EQ (til BE) - samme regler som EQ-indikatoren ═════════════
eqBar() =>
    [open[1], high[1], low[1], close[1], time[1]]

[oS, hS, lS, cS, tS] = request.security(syminfo.tickerid, "1", eqBar(), lookahead = barmerge.lookahead_on)
bool  sameTF = timeframe.in_seconds() == 60
float o1 = sameTF ? open  : oS
float h1 = sameTF ? high  : hS
float l1 = sameTF ? low   : lS
float c1 = sameTF ? close : cS
int   t1 = sameTF ? time  : tS

var int lastT1 = na
bool t1Chg = not na(t1) and t1 != nz(lastT1, -1)
if t1Chg
    lastT1 := t1
bool new1m = sameTF ? barstate.isconfirmed : t1Chg

float own   = na(h1) or na(l1) ? na : (h1 + l1) / 2
// En candle der startede foer open (15:29) giver ikke en ny EQ efter open
int   t1m   = na(t1) ? na : hour(t1, tz) * 60 + minute(t1, tz)
bool  preC  = inWin and not na(t1m) and t1m < winS
bool  bearE = new1m and not preC and not na(c1) and c1 < o1 and c1 < own
bool  bullE = new1m and not preC and not na(c1) and c1 > o1 and c1 > own

// Bearish EQ: anker = high, vokser ned
var float dLastMid = na     // EQ-linjen paa den sidst brugte bearish EQ
var float uLastMid = na     // EQ-linjen paa den sidst brugte bullish EQ
var float dTop = na
var float dBot = na
var bool  dAct = false
var int   dHitM = na        // minuttet hvor en bearish EQ sidst blev ramt
var int   uHitM = na        // minuttet hvor en bullish EQ sidst blev ramt
var float dHitMx = na       // hoejeste bearish EQ ramt i minuttet
var float uHitMn = na       // laveste bullish EQ ramt i minuttet
// ... tidligere i minuttet, FOER denne bar
float dHitPrev = not na(dHitM) and dHitM == minB ? dHitMx : na
float uHitPrev = not na(uHitM) and uHitM == minB ? uHitMn : na
// Market open: alle live EQ'er nulstilles (som EQ-indikatoren). EQ'en der stod lige
// foer open er allerede gemt som "EQ foer open".
var bool uAct = false
var int  eqResetDay = na
if inWin and nz(eqResetDay, -1) != dNow
    eqResetDay := dNow
    dAct := false
    uAct := false
if dAct
    // Tjek mod linjen FOER barens egen low flytter den
    float dMid0 = (dTop + dBot) / 2
    if barstate.isconfirmed and high >= dMid0
        dAct := false
        dLastMid := dMid0
        dHitMx := nz(dHitM, -1) != minB ? dMid0 : math.max(dHitMx, dMid0)
        dHitM  := minB
    else
        dBot := math.min(dBot, low)
if bearE and not dAct
    dTop := h1
    dBot := math.min(l1, low)
    dAct := true

// Bullish EQ: anker = low, vokser op
var float uBot = na
var float uTop = na
if uAct
    // Tjek mod linjen FOER barens egen high flytter den
    float uMid0 = (uBot + uTop) / 2
    if barstate.isconfirmed and low <= uMid0
        uAct := false
        uLastMid := uMid0
        uHitMn := nz(uHitM, -1) != minB ? uMid0 : math.min(uHitMn, uMid0)
        uHitM  := minB
    else
        uTop := math.max(uTop, high)
if bullE and not uAct
    uBot := l1
    uTop := math.max(h1, high)
    uAct := true

// EQ foer market open (til BE): kun en EQ der stadig er live. Laases fra 15:30 og
// vokser videre efter open, indtil EQ-linjen rammes (som backtesten).
var float pDT = na     // bearish: top (anker) / bund (vokser ned)
var float pDB = na
var float pUB = na     // bullish: bund (anker) / top (vokser op)
var float pUT = na
// Hvornaar blev EQ'en fra foer open ramt efter open? (minuttet, na = ikke ramt)
// Ramt = brugt op: den kan ikke laengere bruges som BE.
var int preDHitM = na
var int preUHitM = na
var int preDHitT = na
var int preUHitT = na
if tMin < winS
    pDT := dAct ? dTop : na
    pDB := dAct ? dBot : na
    pUB := uAct ? uBot : na
    pUT := uAct ? uTop : na
    preDHitM := na
    preUHitM := na
else
    // Candlens forloeb antages O-L-H-C (groen) / O-H-L-C (roed). Kommer det nye yderpunkt
    // FOER prisen gaar mod linjen, tjekkes mod den flyttede linje - ellers mod den gamle (6/1-26).
    bool gfD = close > open
    bool gfU = close < open
    if na(preDHitM) and not na(pDT)
        if gfD
            pDB := math.min(pDB, low)
        if high >= (pDT + pDB) / 2
            preDHitM := minB
            preDHitT := time
        else if not gfD
            pDB := math.min(pDB, low)
    if na(preUHitM) and not na(pUB)
        if gfU
            pUT := math.max(pUT, high)
        if low <= (pUB + pUT) / 2
            preUHitM := minB
            preUHitT := time
        else if not gfU
            pUT := math.max(pUT, high)
    // 15:29-candlen lukker foer open: dens EQ er ogsaa en 'EQ foer open' (30/3-26),
    // kun hvis der ikke stod en live EQ foer open i samme retning (en EQ der rammes
    // af 15:30-candlen erstattes IKKE - saa er den ramt, 24/2-26).
    if new1m and preC
        if c1 < o1 and c1 < own and na(pDT)
            pDT := h1
            pDB := math.min(l1, low)
            preDHitM := na
        if c1 > o1 and c1 > own and na(pUB)
            pUB := l1
            pUT := math.max(h1, high)
            preUHitM := na
float preDMid = na(pDT) ? na : (pDT + pDB) / 2
float preUMid = na(pUB) ? na : (pUB + pUT) / 2

// Blev EQ'en fra foer open ramt i SAMME minut som entry (foer/paa entry-candlen),
// og ligger den paa profit-siden (eller praktisk talt paa entry)? Saa er
// BE-spottet taget, og tradet er ugyldigt.
preTaken(float eq, int hm, int ht, float px, bool isShort) =>
    float d = na(eq) ? na : (isShort ? px - eq : eq - px)
    // EQ fra foer open: ogsaa ramt AF entry-candlen taeller
    // EQ foer open (BE-siden) ramt i entry-minuttet = altid ugyldig, uanset hvor den ligger ift. entry
    not na(eq) and not na(hm) and hm == minB and d <= beMax


// ═════════════════════ MINUT- OG DAGS-STATUS ═════════════════════
var int  curM    = na
var bool mHi     = false
var bool mLo     = false
var bool mBad    = false
var bool mTraded = false   // der er allerede taget et trade i minuttet
var bool dayHi   = false
var bool dayLo   = false
var int  lastDay = na

var int  dayTr   = 0       // trades i dag
var bool dayWin  = false   // en trade har vundet i dag

bool newDay = inWin and nz(lastDay, -1) != dNow
if newDay
    lastDay := dNow
    dayHi   := false
    dayLo   := false
    dayTr   := 0
    dayWin  := false

// Tegninger fra det aktuelle minut - slettes hvis minuttet bliver ugyldigt
var array<label> minLbls  = array.new<label>()
var array<line>  minLines = array.new<line>()
var array<box>   minBoxes = array.new<box>()

if minB != nz(curM, -1)
    curM := minB
    mHi  := false
    mLo  := false
    mBad := false
    mTraded := false
    array.clear(minLbls)
    array.clear(minLines)
    array.clear(minBoxes)

if inWin
    mHi   := mHi   or hit.swHi
    mLo   := mLo   or hit.swLo
    dayHi := dayHi or hit.swHi
    dayLo := dayLo or hit.swLo

bool justBad = mHi and mLo and not mBad
if justBad
    mBad := true
// Er tradet allerede taget, staar det - minuttet lukker bare for nye trades
bool killMin = justBad and not mTraded
bool dayBad = dayBlock and dayHi and dayLo

if killMin
    while array.size(minLbls) > 0
        label.delete(array.pop(minLbls))
    while array.size(minLines) > 0
        line.delete(array.pop(minLines))
    while array.size(minBoxes) > 0
        box.delete(array.pop(minBoxes))

// ═════════════════════ BOKS-STATUS ═════════════════════
var string bxStatus = ""
var color  bxCol    = color.gray
var string bxLvl    = ""
var string bxBE     = ""
var string bxTime   = ""
var int    pendM    = na
// Sidste gyldige trade i dag - vises igen naar en "mulighed" udloeber
var string tStatus = ""
var color  tCol    = color.gray
var string tLvl    = ""
var string tBE     = ""
var string tTime   = ""
var int    tM      = na

// Ny dag: tom boks
if newDay
    bxStatus := ""
    tStatus  := ""
    tM       := na
    pendM    := na

if inWin and hit.swTxt != "" and not mBad and not dayBad
    bxStatus := "Mulighed for SMT"
    bxCol    := color.yellow
    bxLvl    := hit.swTxt
    bxBE     := ""
    bxTime   := str.format_time(time, "HH:mm:ss", dispTz)
    pendM    := minB

// Close tilbage, men ikke begge samme vej -> vis grunden (venter stadig)
if not na(pendM) and pendM == minB and hit.noDir and not hit.fired
    bxStatus := "Close tilbage - men ikke begge samme vej"
    bxCol    := color.orange

// Det andet indeks tog ogsaa niveauet -> ingen SMT (det er Vergence)
if inWin and hit.both and not hit.fired and not mBad
    pendM    := na
    bxStatus := "Ingen SMT - begge har taget " + hit.bothTxt + " (Vergence)"
    bxCol    := color.gray
    bxLvl    := ""
    bxBE     := ""
    bxTime   := str.format_time(time, "HH:mm:ss", dispTz)

// Close tilbage, men SL ville vaere over max -> ugyldigt
if not na(pendM) and pendM == minB and hit.slBad and not hit.fired
    pendM    := na
    bxStatus := "Ingen SMT - SL > " + str.tostring(maxSL, "#")
    bxCol    := color.gray
    bxBE     := ""

// ── MAX SL-STREGEN: 30 points fra 1m-candlens top (short) / bund (long) ──
var line smx   = na
var bool smxSh = false
var int  smxM  = na
if inWin and hit.swTxt != "" and not mBad and not dayBad and hit.swHi != hit.swLo and showMaxLn
    if na(smx) or smxM != minB
        line.delete(smx)
        smxSh := hit.swHi
        smxM  := minB
        float y0 = smxSh ? m1Hi - maxSL : m1Lo + maxSL
        smx := line.new(time, y0, time + mxAhead * 60000, y0, xloc = xloc.bar_time, color = mxCol, width = 3)
if not na(smx) and smxM == minB
    float y1 = smxSh ? m1Hi - maxSL : m1Lo + maxSL
    line.set_y1(smx, y1)
    line.set_y2(smx, y1)
    line.set_x2(smx, time + mxAhead * 60000)
// Trade: stregen slettes 1 candle efter entry. SL > max: den bliver staaende.
var line smxDel  = na
var int  smxDelT = na
if not na(smxDel) and (barstate.isrealtime ? timenow : time) >= smxDelT
    line.delete(smxDel)
    smxDel := na
if not na(smx) and smxM == minB and hit.fired and not mBad and not dayBad
    smxDel  := smx
    smxDelT := time_close + mxKeepS * 1000
    smx     := na
if not na(smx) and smxM == minB and hit.slBad
    array.push(minLines, smx)
    smx := na
// Minuttet gik uden trade, eller begge tog niveauet -> stregen vaek
if not na(smx) and (smxM != minB or (hit.both and not hit.fired))
    line.delete(smx)
    smx := na

// Sweep mens dags-reglen blokerer -> vis det
if inWin and hit.swTxt != "" and dayBad and not mBad
    bxStatus := "Blokeret - begge sider taget i dag"
    bxCol    := color.gray
    bxLvl    := hit.swTxt
    bxBE     := ""
    bxTime   := str.format_time(time, "HH:mm:ss", dispTz)

// Sweepet gav intet trade i sit minut -> vis sidste trade igen (eller intet)
if not na(pendM) and pendM != minB
    pendM    := na
    bxStatus := tStatus
    bxCol    := tCol
    bxLvl    := tLvl
    bxBE     := tBE
    bxTime   := tTime

// Minuttet blev ugyldigt -> fjern alt der sagde "mulighed" / trade
if killMin or (dayBad and not na(pendM))
    pendM    := na
    if tM == minB
        tStatus := ""
        tM      := na
    bxStatus := "Ugyldig - begge sider taget"
    bxCol    := color.gray
    bxLvl    := ""
    bxBE     := ""

// ═════════════════════ AABENT TRADE: BE / SL / TP ═════════════════════
// Naar SL eller TP rammes: BE-linjen stopper dér, og boksen fjernes.
var bool   oLive  = false
var bool   oShort = false
var float  oEntry = na
var float  oSL    = na
var float  oTP    = na
var float  oBE    = na
var bool   oBeHit = false
var int    oT     = na
var int    oM     = na
var int    oBars  = 0
var line   oBeLn  = na
var line   oTpLn  = na
var box    oSlB   = na     // SL-felt
var box    oTpB   = na     // TP-felt
var box    oSlF   = na     // moerkere del af SL-feltet (hvor prisen har vaeret)
var box    oTpF   = na     // moerkere del af TP-feltet
var label  oSlLb  = na     // pris ved SL
var label  oEnLb  = na     // pris ved entry
var label  oTpLb  = na     // pris ved TP
var float  oSL0   = na     // oprindelig SL (til tegningen)
var float  oAdv   = na     // laengst prisen har vaeret mod SL
var float  oFav   = na     // laengst prisen har vaeret mod TP
var string oTime  = ""

// Tradet blev slettet fordi minuttet blev ugyldigt
if oLive and killMin and oM == minB
    oLive := false

if oLive
    // Den moerkere del: fra entry til hvor langt prisen har vaeret i feltet
    oAdv := oShort ? math.max(oAdv, high) : math.min(oAdv, low)
    oFav := oShort ? math.min(oFav, low)  : math.max(oFav, high)
    float advY = oShort ? math.min(oAdv, oSL0) : math.max(oAdv, oSL0)
    float favY = oShort ? math.max(oFav, oTP)  : math.min(oFav, oTP)
    if oShort
        box.set_top(oSlF, math.max(advY, oEntry))
        box.set_bottom(oTpF, math.min(favY, oEntry))
    else
        box.set_bottom(oSlF, math.min(advY, oEntry))
        box.set_top(oTpF, math.max(favY, oEntry))
    bool hitSL = oShort ? high >= oSL : low  <= oSL
    bool hitTP = oShort ? low  <= oTP : high >= oTP
    if hitSL or hitTP
        oLive := false
        if hitTP and not hitSL
            dayWin := true
        line.set_x2(oBeLn, time)
        line.set_x2(oTpLn, time)
        box.set_right(oSlB, time)
        box.set_right(oTpB, time)
        box.set_right(oSlF, time)
        box.set_right(oTpF, time)
        label.set_x(oSlLb, time)
        label.set_x(oEnLb, time)
        label.set_x(oTpLb, time)
        // Viser boksen stadig dette trade -> fjern den
        if bxTime == oTime and (bxStatus == "SHORT" or bxStatus == "LONG")
            bxStatus := ""
        if tTime == oTime
            tStatus := ""
    else
        // BE foerst efter at 2 15s-candles er lukket efter entry
        if not oBeHit and not na(oBE) and oBars >= 2 and (oShort ? low <= oBE : high >= oBE)
            oBeHit := true
            oSL    := oEntry
        // Linjen vokser 1 minut for hvert minut tradet er aabent
        line.set_x2(oBeLn, oT + (beMins + (minB - oM)) * 60000)
        line.set_x2(oTpLn, oT + (beMins + (minB - oM)) * 60000)
        int xr = oT + (beMins + (minB - oM)) * 60000
        box.set_right(oSlB, xr)
        box.set_right(oTpB, xr)
        box.set_right(oSlF, xr)
        box.set_right(oTpF, xr)
        label.set_x(oSlLb, xr)
        label.set_x(oEnLb, xr)
        label.set_x(oTpLb, xr)
        if barstate.isconfirmed
            oBars += 1

// ═════════════════════ TRADE ═════════════════════
bool dayDone = (maxDay > 0 and dayTr >= maxDay) or (stopWin and dayWin)
bool ok      = hit.fired and not mBad and not dayBad and not mTraded and not dayDone   // kun eet trade pr. minut
bool beBadNow = false   // tradet blev ugyldigt fordi BE allerede var ramt
bool goShort = ok and hit.isShort
bool goLong  = ok and not hit.isShort

if ok
    bool  sh = hit.isShort
    float px = close
    pendM := na

    // ── BE: den naermeste kandidat ──
    BeC bc = BeC.new()

    // EQ: short -> bullish EQ'en (bevaegelsen op). long -> bearish EQ'en.
    float lo  = sh ? (uAct ? uBot : na) : (dAct ? dBot : na)
    float hi  = sh ? (uAct ? uTop : na) : (dAct ? dTop : na)
    float mid = na(lo) or na(hi) ? na : (lo + hi) / 2
    float qt  = na(lo) or na(hi) ? na : lo + (sh ? 0.75 : 0.25) * (hi - lo)
    if beEq
        tryBE(bc, px, sh, mid, "EQ")
        tryBE(bc, px, sh, qt,  sh ? "0.75" : "0.25")
    if bePre
        if na(preDHitM)
            tryBE(bc, px, sh, preDMid, "EQ foer open")
        if na(preUHitM)
            tryBE(bc, px, sh, preUMid, "EQ foer open")

    // Session liq som chartet ikke har taget (short: lows, long: highs)
    if beSess
        if not na(asia.lo)
            if not (sh ? asia.lo.aPre : asia.hi.aPre)   // taget foer open -> ikke BE-kandidat
                tryBEt(bc, px, sh, sh ? asia.aLo : asia.aHi, sh ? "Asia low" : "Asia high", sh ? asia.lo.aTook : asia.hi.aTook)
        if not na(lon.lo)
            if not (sh ? lon.lo.aPre : lon.hi.aPre)   // taget foer open -> ikke BE-kandidat
                tryBEt(bc, px, sh, sh ? lon.aLo : lon.aHi, sh ? "London low" : "London high", sh ? lon.lo.aTook : lon.hi.aTook)
        if not na(ny.lo)
            if not (sh ? ny.lo.aPre : ny.hi.aPre)   // taget foer open -> ikke BE-kandidat
                tryBEt(bc, px, sh, sh ? ny.aLo : ny.aHi, sh ? "NY PRE low" : "NY PRE high", sh ? ny.lo.aTook : ny.hi.aTook)

    // 15m-niveauer som chartet ikke har taget
    if be15 and array.size(lv15) > 0
        for i = 0 to array.size(lv15) - 1
            Lv m = array.get(lv15, i)
            if m.isHi != sh and not m.dead and not m.st.aTook
                tryBE(bc, px, sh, m.a, sh ? "15m low" : "15m high")

    // 5m-niveauer - kun ved trades i 15:30-minuttet
    if be05 and isOpenM and array.size(lv05) > 0
        for i = 0 to array.size(lv05) - 1
            Lv m = array.get(lv05, i)
            if m.isHi != sh and not m.dead and not m.st.aTook
                tryBE(bc, px, sh, m.a, sh ? "5m low" : "5m high")

    // EQ fra foer open ramt i entry-minuttet -> BE-spottet er taget (endelig afgoerelse)
    // kun EQ'en paa BE-siden: short -> bullish (under), long -> bearish (over)
    if bePre and preInv and (sh ? preTaken(preUMid, preUHitM, preUHitT, px, sh) : preTaken(preDMid, preDHitM, preDHitT, px, sh))
        bc.bad := true
        bc.src := "EQ foer open"
    // Liq i trade-retningen taget i entry-minuttet (foer/paa entry-candlen)
    // LONG: bearish EQ eller session high. SHORT: bullish EQ eller session low.
    // ... og kun hvis niveauet ligger paa BE-siden af entry (ikke allerede bag entry)
    bool eqTaken = sh ? (not na(uHitPrev) and px - uHitPrev >= -beMin) : (not na(dHitPrev) and dHitPrev - px >= -beMin)
    bool slTaken = sh ? (not na(sLoPrev) and px - sLoPrev >= -beMin) : (not na(sHiPrev) and sHiPrev - px >= -beMin)
    if eqTaken or slTaken
        bc.bad := true
        bc.src := eqTaken ? (sh ? "bullish EQ" : "bearish EQ") : (sh ? "session low" : "session high")
    float  be    = bc.v
    string beSrc = bc.src

    beBadNow := bc.bad
    if bc.bad
        bxStatus := "Ingen SMT - BE (" + bc.src + ") allerede ramt"
        bxCol    := color.gray
        bxLvl    := hit.src + " (" + hit.who + ")"
        bxBE     := ""
        bxTime   := str.format_time(time, "HH:mm:ss", dispTz)
    if not bc.bad
        // ── Lille markering paa chartet ──
        color c = sh ? shortCol : longCol
        label lb = label.new(time, sh ? high : low, "SMT", xloc = xloc.bar_time,
             style = sh ? label.style_label_down : label.style_label_up,
             color = color.new(c, 10), textcolor = sh ? color.white : color.black, size = size.small)
        label.set_tooltip(lb, (sh ? "SHORT - " : "LONG - ") + hit.src + " swept (" + hit.who + ")")
        array.push(minLbls, lb)
        line beL = na
        if showBE and not na(bc.v)
            beL := line.new(time, bc.v, time + beMins * 60000, bc.v, xloc = xloc.bar_time,
                 color = beCol, width = 2, style = line.style_dashed)
            array.push(minLines, beL)

        // ── SL / TP ──
        float slX = sh ? math.max(m1Hi, px + minSL) : math.min(m1Lo, px - minSL)
        float tpX = na
        string tpS = "75p"
        // Kandidater: EQ (begge live EQ'er) og session liq som chartet ikke har taget
        array<float>  tc = array.new<float>()
        array<string> tn = array.new<string>()
        if uAct
            array.push(tc, (uBot + uTop) / 2)
            array.push(tn, "EQ")
        if dAct
            array.push(tc, (dBot + dTop) / 2)
            array.push(tn, "EQ")
        for i = 0 to 2
            Sess s  = i == 0 ? asia : (i == 1 ? lon : ny)
            St   st = sh ? s.lo : s.hi
            if not na(st) and not st.aTook
                array.push(tc, sh ? s.aLo : s.aHi)
                array.push(tn, (i == 0 ? "Asia" : (i == 1 ? "London" : "NY PRE")) + (sh ? " low" : " high"))
        if array.size(tc) > 0
            for i = 0 to array.size(tc) - 1
                float cx = array.get(tc, i)
                float d  = na(cx) ? na : (sh ? px - cx : cx - px)
                if not na(d) and d >= tpMin and d <= tpMax and (na(tpX) or d < math.abs(px - tpX))
                    tpX := cx
                    tpS := array.get(tn, i)
        if na(tpX)
            tpX := sh ? px - tpMax : px + tpMax

        line tpL = na
        if showBE and not showPos
            tpL := line.new(time, tpX, time + beMins * 60000, tpX, xloc = xloc.bar_time,
                 color = tpCol, width = 2, style = line.style_dashed)
            array.push(minLines, tpL)

        // Nyt trade afloeser et evt. aabent
        if oLive
            line.set_x2(oBeLn, time)
            line.set_x2(oTpLn, time)
            box.set_right(oSlB, time)
            box.set_right(oTpB, time)
            box.set_right(oSlF, time)
            box.set_right(oTpF, time)
            label.set_x(oSlLb, time)
            label.set_x(oEnLb, time)
            label.set_x(oTpLb, time)
        oLive  := true
        mTraded := true
        dayTr  += 1
        oShort := sh
        oEntry := px
        oSL    := slX
        oTP    := tpX
        oBE    := bc.v
        oBeHit := false
        oT     := time
        oM     := minB
        oBars  := 0
        oBeLn  := beL
        oTpLn  := tpL
        oSL0   := slX
        oAdv   := px
        oFav   := px
        oSlB   := na
        oTpB   := na
        oSlF   := na
        oTpF   := na
        if showBE and showPos
            int xr0 = time + beMins * 60000
            oSlB := box.new(time, math.max(slX, px), xr0, math.min(slX, px), xloc = xloc.bar_time, border_color = color.new(#F23645, 100), bgcolor = posSlCol)
            oTpB := box.new(time, math.max(tpX, px), xr0, math.min(tpX, px), xloc = xloc.bar_time, border_color = color.new(#089981, 100), bgcolor = posTpCol)
            oSlF := box.new(time, px, xr0, px, xloc = xloc.bar_time, border_color = color.new(#F23645, 100), bgcolor = posSlHit)
            oTpF := box.new(time, px, xr0, px, xloc = xloc.bar_time, border_color = color.new(#089981, 100), bgcolor = posTpHit)
            array.push(minBoxes, oSlB)
            array.push(minBoxes, oTpB)
            array.push(minBoxes, oSlF)
            array.push(minBoxes, oTpF)
        oSlLb := na
        oEnLb := na
        oTpLb := na
        if showBE and showPos and showPx
            int xr1 = time + beMins * 60000
            oSlLb := label.new(xr1, slX, str.tostring(slX, format.mintick), xloc = xloc.bar_time, style = label.style_label_left,
                 color = color.new(color.black, 100), textcolor = color.new(#F23645, 0), size = size.small)
            oEnLb := label.new(xr1, px,  str.tostring(px,  format.mintick), xloc = xloc.bar_time, style = label.style_label_left,
                 color = color.new(color.black, 100), textcolor = pxCol, size = size.small)
            oTpLb := label.new(xr1, tpX, str.tostring(tpX, format.mintick), xloc = xloc.bar_time, style = label.style_label_left,
                 color = color.new(color.black, 100), textcolor = color.new(#089981, 0), size = size.small)
            array.push(minLbls, oSlLb)
            array.push(minLbls, oEnLb)
            array.push(minLbls, oTpLb)
        oTime  := str.format_time(time, "HH:mm:ss", dispTz)

        // ── Boksen ──
        bxStatus := sh ? "SHORT" : "LONG"
        bxCol    := c
        bxLvl    := hit.src + " (" + hit.who + ")"
        bxBE     := not showBE ? "" : (na(be) ? "-" : beSrc) + "    TP: " + tpS
        bxTime   := str.format_time(time, "HH:mm:ss", dispTz)
        tStatus  := bxStatus
        tCol     := bxCol
        tLvl     := bxLvl
        tBE      := bxBE
        tTime    := bxTime
        tM       := minB

// ═════════════════════ BOKSEN I HJOERNET ═════════════════════
var table bx = table.new(boxPos, 2, 4, bgcolor = color.new(color.black, 20), border_width = 1)
if barstate.islast
    table.clear(bx, 0, 0, 1, 3)
    if bxStatus != ""
        table.cell(bx, 0, 0, bxStatus, text_color = bxCol, text_size = boxSize)
        table.cell(bx, 1, 0, bxTime,   text_color = color.gray, text_size = boxSize)
        if bxLvl != ""
            table.cell(bx, 0, 1, "Swept", text_color = color.gray,  text_size = boxSize)
            table.cell(bx, 1, 1, bxLvl,   text_color = color.white, text_size = boxSize)
        if bxBE != ""
            table.cell(bx, 0, 2, "BE / TP",  text_color = color.gray,  text_size = boxSize)
            table.cell(bx, 1, 2, bxBE,  text_color = beCol,       text_size = boxSize)

bool anySweep = inWin and hit.swTxt != "" and not mBad and not dayBad
alertcondition(anySweep, "Mulighed for SMT", "Mulighed for SMT - et niveau er swept")
alertcondition(goShort and not beBadNow,  "SMT SHORT", "SMT SHORT - liq taget og 15s close tilbage under")
alertcondition(goLong and not beBadNow,   "SMT LONG",  "SMT LONG - liq taget og 15s close tilbage over")

var label tfWarn = na
if warn15s and barstate.islast
    label.delete(tfWarn)
    tfWarn := timeframe.in_seconds() != 15 ? label.new(bar_index, high,
         "Laeg chartet paa 15s - entry laeses paa 15s-candles",
         color = color.orange, textcolor = color.black, style = label.style_label_down, size = size.small) : na
