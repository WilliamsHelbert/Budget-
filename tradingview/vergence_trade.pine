//@version=6
// =====================================================================
//  Vergence  (v3.1)  - samme model som backtesten (oktober 2026)
//  ---------------------------------------------------------------
//  NYT I v3.1 (9/10-26)
//    - EQ FOER OPEN ramt i entry-minuttet goer IKKE laengere tradet ugyldigt
//      (testet paa 2023-2026: reglen var overfit paa 2026). EQ'en bruges stadig
//      som BE, saa laenge den ikke er ramt. Kan slaas til igen under BE-indstillinger.
//  ---------------------------------------------------------------
//  MODELLEN
//    - Begge indeks skal tage SAMME niveau (Asia / London / NY PRE
//      high/low eller et NY PRE 15m-niveau til 15:31), hver sit eget
//      niveau, mindst 1 tick forbi. Det andet indeks senest 5 min efter.
//    - Et niveau der tages foerste gang i vinduet = FRISK liq. Bagefter
//      flytter niveauet med indeksets nye yderpunkt. Nye yderpunkter
//      taeller som liq, indtil siden har haft sin foerste Vergence.
//    - Det indeks der tager frisk liq i det minut der fuldender
//      Vergence, skal lukke tilbage forbi niveauet (begge, hvis begge
//      tog frisk liq i samme minut).
//    - ENTRY: den FOERSTE 15s-candle hvor begge indeks lukker i
//      retningen afgoer. Close tilbage og SL <= 30 -> trade. Ellers ingen.
//    - TID CLOSE: entry paa den candle der fuldender Vergence eller den
//      naeste. 3. candle eller senere = intet trade.
//    - Samme minut som sweepet. High- og low-side taget i samme minut
//      = ugyldigt. Kun eet trade pr. minut.
//    - BE kun EQ (EQ, 0.25/0.75, EQ foer open) og session liq - ikke
//      5m/15m (kan slaas til). Intet BE de foerste 2 candles.
//    - EQ foer open vokser videre efter open til den rammes; er der
//      ingen live EQ ved open, bruges 15:29-candlens EQ.
//    - Samlet niveau paa bare eet indeks (fx London samlet i NY PRE
//      high paa NQ) er ikke sit eget niveau.
//    - Max 2 trades pr. dag, stop for dagen efter en vundet trade.
//
//  Laeg den paa et 15s-chart. Vindue 15:30-15:59 dansk (09:30 NY).
// =====================================================================
indicator("Helbert's Hjælpe Indikator (Vergence)", overlay = true,
     max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// ─────────────────────────── INPUTS ───────────────────────────
g1 = "Symboler"
cmpSym = input.symbol("CME_MINI:ES1!", "Sammenlign med", group = g1,
     tooltip = "Ligger du paa NQ, skal denne staa paa ES - og omvendt.")

g2 = "Sessioner"
// Tider i New York-tid: market open er altid 09:30 NY (14:30 dansk i ugerne i marts og okt/nov
// hvor USA og Europa skifter sommertid paa hver sin dato).
tz       = input.string("America/New_York", "Tidszone (NY)", group = g2)
dispTz   = input.string("Europe/Copenhagen", "Tidszone til visning", group = g2)
asiaSess = input.session("2000-0200", "Asia (NY-tid)",   group = g2, tooltip = "= 02:00-08:00 dansk")
lonSess  = input.session("0200-0800", "London (NY-tid)", group = g2, tooltip = "= 08:00-14:00 dansk")
nySess   = input.session("0800-0930", "NY PRE (NY-tid)", group = g2, tooltip = "= 14:00-15:30 dansk")
useAsia  = input.bool(true, "Asia",   group = g2, inline = "s")
useLon   = input.bool(true, "London", group = g2, inline = "s")
useNy    = input.bool(true, "NY PRE", group = g2, inline = "s")
use15    = input.bool(true, "15m",    group = g2, inline = "s")

g3 = "Vindue"
openHour = input.int(9, "Start - time (NY)",  minval = 0, maxval = 23, group = g3)
openMin  = input.int(30, "Start - minut (NY)", minval = 0, maxval = 59, group = g3)
endHour  = input.int(10, "Slut - time NY (til, ikke med)",  minval = 0, maxval = 23, group = g3)
endMin   = input.int(0,  "Slut - minut NY (til, ikke med)", minval = 0, maxval = 59, group = g3,
     tooltip = "16:00 betyder at 15:59 er det sidste minut med.")
m15H     = input.int(9, "15m-niveauer gaelder til - time (NY)",  minval = 0, maxval = 23, group = g3)
m15M     = input.int(31, "15m-niveauer gaelder til - minut (NY)", minval = 0, maxval = 59, group = g3,
     tooltip = "Samme som 'Fjern igen' paa Session Levels. Default 15:31.")
maxGap   = input.int(5, "Max minutter mellem de to sweeps", minval = 0, maxval = 60, group = g3,
     tooltip = "NQ 15:31 og 5 -> ES skal tage niveauet senest 15:36.")

g6 = "Regler"
needBack  = input.bool(true, "Kraev luk tilbage forbi niveauet", group = g6)
tidClose  = input.int(2, "Tid close: entry senest paa candle nr. (0 = fra)", minval = 0, maxval = 4, group = g6,
     tooltip = "Taelles fra den 15s-candle der fuldender Vergence. 2 = den candle eller den naeste.")
mergeEither = input.bool(true, "Samlet niveau paa eet indeks er ikke eget niveau", group = g6)
maxDay    = input.int(2, "Max trades pr. dag", minval = 0, group = g6)
stopWin   = input.bool(true, "Stop for dagen efter en vundet trade", group = g6)
dayBlock  = input.bool(false, "Bloker resten af dagen naar begge sider er taget", group = g6,
     tooltip = "Fra (standard): kun SAMME minut goer det ugyldigt. Til: er der siden open taget baade en high-side og en low-side, kommer der ikke flere trades den dag.")
minSL     = input.float(10, "Minimum SL (points) - 1R", minval = 0, group = g6)
maxSL     = input.float(30, "Max SL (points) - 3R", minval = 1, group = g6,
     tooltip = "Maales fra bunden (long) eller toppen (short) af det minut-candle entry ligger i.")
blockMax  = input.bool(true, "Ugyldigt trade hvis SL > max", group = g6)
showMaxLn = input.bool(true, "Tegn max SL-stregen", group = g6)

g4 = "BE"
beSym   = input.string("NQ", "Vis BE kun paa symbol der indeholder", group = g4)
beMin   = input.float(2,  "BE mindst (points) fra entry", minval = 0, group = g4)
beMax   = input.float(50, "BE hoejst (points) fra entry", minval = 1, group = g4)

g7 = "SL / TP"
tpMin  = input.float(35, "TP mindst (points)", minval = 0, group = g7)
tpMax  = input.float(75, "TP max / fallback (points)", minval = 1, group = g7,
     tooltip = "TP = det naermeste af EQ og session liq, der ligger mellem TP mindst og TP max fra entry. Ligger intet inden for, bruges TP max. SL = toppen (short) / bunden (long) af det 1m-candle entry sker i - fast, kun flyttet til entry ved BE.")
tpCol  = input.color(color.teal, "TP-linje", group = g7)
g8 = "Position (kun NQ)"
showPos  = input.bool(true, "Tegn position (SL + TP)", group = g8)
posSlCol = input.color(color.new(#F23645, 78), "SL-felt",            group = g8)
posSlHit = input.color(color.new(#F23645, 55), "SL-felt (prisen har vaeret der)", group = g8)
posTpCol = input.color(color.new(#089981, 78), "TP-felt",            group = g8)
posTpHit = input.color(color.new(#089981, 55), "TP-felt (prisen har vaeret der)", group = g8)
showPx   = input.bool(true, "Skriv prisen ved entry / SL / TP", group = g8)
pxCol    = input.color(color.gray, "Entry-pris", group = g8)
beEq    = input.bool(true, "EQ og 0.25 / 0.75",        group = g4)
beSess  = input.bool(true, "Session liq",              group = g4)
be15    = input.bool(false, "15m-niveauer",             group = g4)
be05    = input.bool(false, "5m-niveauer (kun 15:30)",  group = g4)
bePre   = input.bool(true, "EQ fra foer market open", group = g4,
     tooltip = "EQ-linjen (0.5) paa den bullish og bearish EQ der stod lige foer 15:30 - live, ellers den sidst brugte. Laases ved open og kan bruges som BE resten af vinduet.")
preInv  = input.bool(false, "EQ foer open ramt = ugyldigt trade", group = g4,
     tooltip = "Fra som standard (9/10-26). Til = er EQ foer open paa BE-siden ramt i entry-minuttet, er tradet ugyldigt (gammel regel).")

g5 = "Visning"
bearCol  = input.color(color.red,    "Short", group = g5)
bullCol  = input.color(color.lime,   "Long",  group = g5)
mxCol    = input.color(color.red, "Max SL-streg", group = g5)
mxKeepS  = input.int(15, "Max SL-stregen bliver staaende efter entry (sekunder)", minval = 0, maxval = 300, group = g5,
     tooltip = "Regnet fra entry-candlens close. 15 = hele den foelgende 15s-candle.")
mxAhead  = input.int(2, "Max SL-stregen raekker frem (minutter)", minval = 0, maxval = 15, group = g5,
     tooltip = "Stregen starter ved signalet og raekker saa mange minutter frem fra den aktuelle candle, saa den er let at se.")
beCol    = input.color(color.orange, "BE-linje", group = g5)
beMins   = input.int(5, "BE-linjens start-laengde (minutter)", minval = 1, group = g5,
     tooltip = "Linjen vokser 1 minut for hvert minut tradet er aabent, og stopper der hvor SL eller TP bliver ramt.")
boxPosS  = input.string("Nederst midt", "Boksens placering",
     options = ["Nederst midt", "Nederst hoejre", "Nederst venstre", "Oeverst midt", "Oeverst hoejre", "Oeverst venstre"], group = g5,
     tooltip = "Sweep Trade-boksen ligger nederst til hoejre - saa ligger de ikke oven i hinanden.")
boxSizeS = input.string("Normal", "Boksens tekststoerrelse", options = ["Lille", "Normal", "Stor"], group = g5)
warn15s  = input.bool(true, "Advar hvis chartet ikke er 15s", group = g5)

boxPos = switch boxPosS
    "Nederst hoejre"  => position.bottom_right
    "Nederst venstre" => position.bottom_left
    "Oeverst midt"    => position.top_center
    "Oeverst hoejre"  => position.top_right
    "Oeverst venstre" => position.top_left
    => position.bottom_center

boxSize = switch boxSizeS
    "Lille" => size.small
    "Stor"  => size.large
    => size.normal

// ───────── SAMMENLIGNINGSSYMBOLET ─────────
[bHigh, bLow, bOpen, bClose] = request.security(cmpSym, timeframe.period, [high, low, open, close],
     gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

bool bothBear = close < open and not na(bClose) and not na(bOpen) and bClose < bOpen
bool bothBull = close > open and not na(bClose) and not na(bOpen) and bClose > bOpen

string aName  = syminfo.ticker
string bName  = str.contains(cmpSym, ":") ? array.get(str.split(cmpSym, ":"), 1) : cmpSym
bool   showBE = str.contains(syminfo.ticker, beSym)   // BE / TP tegnes kun paa NQ

float tick     = syminfo.mintick
float tickHalf = tick / 2
int   minB     = int(time / 60000)

// ─────────────────── TID ───────────────────
int  tMin    = hour(time, tz) * 60 + minute(time, tz)
int  winS    = openHour * 60 + openMin
int  winE    = endHour  * 60 + endMin
bool inWin   = tMin >= winS and tMin < winE
bool isOpenM = tMin == winS
int  dNow    = dayofmonth(time, tz)

int  mn = minute(time, tz)
var float m1Hi = na
var float m1Lo = na
bool newMin = mn != mn[1]
m1Hi := newMin ? high : math.max(nz(m1Hi, high), high)
m1Lo := newMin ? low  : math.min(nz(m1Lo, low),  low)

int  aT = time(timeframe.period, asiaSess, tz)
int  lT = time(timeframe.period, lonSess,  tz)
int  nT = time(timeframe.period, nySess,   tz)
bool aOn = not na(aT)
bool lOn = not na(lT)
bool nOn = not na(nT)
bool aStart = aOn and na(aT[1])
bool lStart = lOn and na(lT[1])
bool nStart = nOn and na(nT[1])

fmtM(int m) =>
    na(m) ? "-" : str.format_time(m * 60000, "HH:mm", tz)

// ─────────────────────────── TYPER ───────────────────────────
// Status for EEN side (high eller low) af eet niveau.
//   aLv/bLv = niveauet efter det er taget i vinduet (indeksets yderpunkt siden)
//   aTook   = chartets symbol har taget niveauet (kan ikke bruges som BE)
type St
    float aLv   = na
    float bLv   = na
    bool  aTook = false

type Sess
    float aHi = na
    float aLo = na
    float bHi = na
    float bLo = na
    St    hi  = na
    St    lo  = na
    // Taget i en senere session (foer open) -> niveauet flytter med
    bool  maHi = false   // chartets symbol
    bool  maLo = false
    bool  mbHi = false   // det andet indeks
    bool  mbLo = false

// Eet NY PRE 15m- eller 5m-niveau.
type Lv
    float a     = na
    float b     = na
    bool  isHi  = false
    bool  dead  = false
    bool  aTook = false
    St    st    = na

// Frisk liq: minut, niveau, navn, brugt i en Vergence
type Fr
    int    m = na
    float  l = na
    string n = ""
    bool   u = false

// Status for een side (true = high-siden / short) i dag
type Side
    array<Fr> aF
    array<Fr> bF
    int   aE    = na     // minuttet chartets symbol sidst tog liq der taeller
    int   bE    = na
    bool  had   = false  // siden har haft sin foerste Vergence
    bool  isNew = false  // ny liq paa denne bar
    float aFL   = na     // yderste friske niveau i minuttet aFM
    float bFL   = na
    int   aFM   = na
    int   bFM   = na

// En fuldendt Vergence der venter paa close
type Arm
    bool   sh = false
    float  a  = na       // chartets friske niveau (na = tog ikke frisk liq)
    float  b  = na
    string nm = ""
    int    t  = na       // tid for candlen der fuldendte den

// Hvad skete der paa denne bar?
type Hit
    bool   first   = false   // det ene indeks tog et niveau
    string firstTx = ""
    bool   swHi    = false   // et high-niveau blev taget i vinduet
    bool   swLo    = false
    bool   sHi     = false   // chartet tog et session high (foerste gang) i vinduet
    float  sHiV    = na
    bool   sLo     = false
    float  sLoV    = na

type BeC
    float  v   = na
    string src = ""
    bool   bad = false   // den valgte BE er allerede ramt -> tradet er ugyldigt

newSide() =>
    Side.new(array.new<Fr>(), array.new<Fr>())

// ─────────────────────────── FUNKTIONER ───────────────────────────
build(Sess s, bool isStart) =>
    if isStart
        s.aHi := high
        s.aLo := low
        s.bHi := bHigh
        s.bLo := bLow
        s.hi  := St.new()
        s.lo  := St.new()
        s.maHi := false
        s.maLo := false
        s.mbHi := false
        s.mbLo := false
    else
        s.aHi := math.max(s.aHi, high)
        s.aLo := math.min(s.aLo, low)
        s.bHi := na(bHigh) ? s.bHi : math.max(nz(s.bHi, bHigh), bHigh)
        s.bLo := na(bLow)  ? s.bLo : math.min(nz(s.bLo, bLow),  bLow)
    true

// Tjek een side af eet niveau. Kun i vinduet.
check(St st, float aL, float bL, bool isHi, string nm, Hit h, Side sd) =>
    if not na(st) and not na(aL) and not na(bL)
        bool aSweep = isHi ? high >= aL + tick : low <= aL - tick
        string lvlNm = nm + (isHi ? " high" : " low")
        // Session high/low taget i vinduet (kun foerste gang)
        if inWin and aSweep and not st.aTook and nm != "15m"
            if isHi
                h.sHi  := true
                h.sHiV := na(h.sHiV) ? aL : math.max(h.sHiV, aL)
            else
                h.sLo  := true
                h.sLoV := na(h.sLoV) ? aL : math.min(h.sLoV, aL)
        if aSweep
            st.aTook := true
        if inWin
            float curA = na(st.aLv) ? aL : st.aLv
            float curB = na(st.bLv) ? bL : st.bLv
            bool newA = isHi ? high >= curA + tick : low <= curA - tick
            bool newB = not na(bHigh) and not na(bLow) and (isHi ? bHigh >= curB + tick : bLow <= curB - tick)
            bool frA = newA and na(st.aLv)
            bool frB = newB and na(st.bLv)
            if newA
                if frA
                    array.push(sd.aF, Fr.new(minB, aL, lvlNm, false))
                    sd.aFL := nz(sd.aFM, -1) != minB or na(sd.aFL) ? aL : (isHi ? math.max(sd.aFL, aL) : math.min(sd.aFL, aL))
                    sd.aFM := minB
                if frA or not sd.had
                    sd.aE    := minB
                    sd.isNew := true
                st.aLv := isHi ? high : low
            if newB
                if frB
                    array.push(sd.bF, Fr.new(minB, bL, lvlNm, false))
                    sd.bFL := nz(sd.bFM, -1) != minB or na(sd.bFL) ? bL : (isHi ? math.max(sd.bFL, bL) : math.min(sd.bFL, bL))
                    sd.bFM := minB
                if frB or not sd.had
                    sd.bE    := minB
                    sd.isNew := true
                st.bLv := isHi ? bHigh : bLow
            if newA or newB
                h.swHi := h.swHi or isHi
                h.swLo := h.swLo or not isHi
            if (frA and na(st.bLv)) or (frB and na(st.aLv))
                h.first   := true
                h.firstTx := lvlNm + "  (" + (frA ? aName : bName) + " " + fmtM(minB)
                     + ", venter paa " + (frA ? bName : aName) + " til " + fmtM(minB + maxGap) + ")"
    true

hasName(array<Fr> L, string n) =>
    bool f = false
    for x in L
        if x.n == n
            f := true
    f

hasMin(array<Fr> L, int m) =>
    bool f = false
    for x in L
        if x.m == m
            f := true
    f

// Er Vergence fuldendt paa denne side? Begge indeks har taget samme niveau, mindst
// eet af dem frisk, hoejst maxGap min fra hinanden. Returnerer en Arm (ellers na).
resolve(Side sd, bool isHi) =>
    Arm out = na
    if sd.isNew
        array<Fr> fa = array.new<Fr>()
        array<Fr> fb = array.new<Fr>()
        for f in sd.aF
            if not f.u and not na(sd.bE) and math.abs(f.m - sd.bE) <= maxGap and hasName(sd.bF, f.n)
                array.push(fa, f)
        for f in sd.bF
            if not f.u and not na(sd.aE) and math.abs(f.m - sd.aE) <= maxGap and hasName(sd.aF, f.n)
                array.push(fb, f)
        if array.size(fa) > 0 or array.size(fb) > 0
            // kun det indeks der tager frisk liq i DETTE minut skal lukke tilbage
            array<Fr> faN = array.new<Fr>()
            array<Fr> fbN = array.new<Fr>()
            for f in fa
                if f.m == minB
                    array.push(faN, f)
            for f in fb
                if f.m == minB
                    array.push(fbN, f)
            if array.size(faN) > 0 or array.size(fbN) > 0
                fa := faN
                fb := fbN
            // close tilbage maales mod det yderste niveau indekset tog i samme minut
            array<Fr> fa2 = array.new<Fr>()
            array<Fr> fb2 = array.new<Fr>()
            for f in sd.aF
                if hasMin(fa, f.m)
                    array.push(fa2, f)
            for f in sd.bF
                if hasMin(fb, f.m)
                    array.push(fb2, f)
            float aLv = na
            float bLv = na
            string nms = ""
            for f in fa2
                aLv := na(aLv) ? f.l : (isHi ? math.max(aLv, f.l) : math.min(aLv, f.l))
                f.u := true
                if not str.contains(nms, f.n)
                    nms := nms == "" ? f.n : nms + " / " + f.n
            for f in fb2
                bLv := na(bLv) ? f.l : (isHi ? math.max(bLv, f.l) : math.min(bLv, f.l))
                f.u := true
                if not str.contains(nms, f.n)
                    nms := nms == "" ? f.n : nms + " / " + f.n
            sd.had := true
            out := Arm.new(isHi, aLv, bLv, nms, time)
        sd.isNew := false
    out

pushLv(array<Lv> arr, float ah, float al, float bh, float bl) =>
    Lv h = Lv.new()
    h.a    := ah
    h.b    := bh
    h.isHi := true
    h.st   := St.new()
    array.push(arr, h)
    Lv l = Lv.new()
    l.a    := al
    l.b    := bl
    l.isHi := false
    l.st   := St.new()
    array.push(arr, l)

// Taget mens NY PRE koerer (paa et af indeksene) -> ugyldigt
killInNy(array<Lv> arr) =>
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            Lv m = array.get(arr, i)
            bool aHit = m.isHi ? high >= m.a : low <= m.a
            bool bHit = m.isHi ? (not na(bHigh) and bHigh >= m.b) : (not na(bLow) and bLow <= m.b)
            if aHit or bHit
                m.dead := true

// Efter NY PRE: hold styr paa om chartet har taget niveauet
markTook(array<Lv> arr) =>
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            Lv m = array.get(arr, i)
            if m.isHi ? high >= m.a : low <= m.a
                m.aTook := true

// BE-kandidat: i profit-retningen, mellem beMin og beMax fra entry,
// og naermere end den hidtil bedste -> bliver den nye BE.
tryBE(BeC b, float px, bool isShort, float c, string nm) =>
    bool  dir = not na(c) and (isShort ? c < px : c > px)
    float d   = na(c) ? 0.0 : math.abs(px - c)
    if dir and d >= beMin and d <= beMax and (na(b.v) or d < math.abs(px - b.v))
        b.v   := c
        b.src := nm
        b.bad := false
    b.v

// Som tryBE, men for et niveau der kan vaere ramt foer entry
// (EQ fra foer open og session liq). Bliver det valgt og er det ramt,
// er tradet ugyldigt.
tryBEt(BeC b, float px, bool isShort, float c, string nm, bool taken) =>
    bool  dir = not na(c) and (isShort ? c < px : c > px)
    float d   = na(c) ? 0.0 : math.abs(px - c)
    if dir and d >= beMin and d <= beMax and (na(b.v) or d < math.abs(px - b.v))
        b.v   := c
        b.src := nm
        b.bad := taken
    b.v

// ─────────────────── SESSIONER ───────────────────
var Sess asia = Sess.new()
var Sess lon  = Sess.new()
var Sess ny   = Sess.new()

// Tager et indeks en tidligere sessions high/low i en senere session (foer open), er
// niveauet ikke brugt - det flytter med til den nye high/low (fx "NY PRE + London").
mergeSess(Sess s, bool on) =>
    if not on and tMin < winS and not na(s.aHi)
        if high > s.aHi
            s.aHi  := high
            s.maHi := true
        if low < s.aLo
            s.aLo  := low
            s.maLo := true
        if not na(bHigh) and not na(s.bHi) and bHigh > s.bHi
            s.bHi  := bHigh
            s.mbHi := true
        if not na(bLow) and not na(s.bLo) and bLow < s.bLo
            s.bLo  := bLow
            s.mbLo := true
    true

mergeSess(asia, aOn)
mergeSess(lon,  lOn)

if aOn
    build(asia, aStart)
if lOn
    build(lon, lStart)
if nOn
    build(ny, nStart)

// ─────────────────── NY PRE 15m- OG 5m-NIVEAUER (til BE) ───────────────────
lvBar() =>
    [high[1], low[1], time[1]]

[qH, qL, qT] = request.security(syminfo.tickerid, "15", lvBar(), lookahead = barmerge.lookahead_on)
[eH, eL, eT] = request.security(cmpSym,           "15", lvBar(), lookahead = barmerge.lookahead_on)
[fH, fL, fT] = request.security(syminfo.tickerid, "5",  lvBar(), lookahead = barmerge.lookahead_on)
[gH, gL, gT] = request.security(cmpSym,           "5",  lvBar(), lookahead = barmerge.lookahead_on)

var int lastQt = na
bool newM15 = not na(qT) and qT != nz(lastQt, -1)
if newM15
    lastQt := qT
var int lastFt = na
bool newM05 = not na(fT) and fT != nz(lastFt, -1)
if newM05
    lastFt := fT

int nyFrom = int(str.tonumber(str.substring(nySess, 0, 2))) * 60 + int(str.tonumber(str.substring(nySess, 2, 4)))
inNyAt(int t) =>
    int m = na(t) ? na : hour(t, tz) * 60 + minute(t, tz)
    not na(m) and m >= nyFrom and m < winS

var array<Lv> lv15 = array.new<Lv>()
var array<Lv> lv05 = array.new<Lv>()
if nStart
    array.clear(lv15)
    array.clear(lv05)
if newM15 and inNyAt(qT) and not na(qH) and not na(eH)
    pushLv(lv15, qH, qL, eH, eL)
if newM05 and inNyAt(fT) and not na(fH) and not na(gH)
    pushLv(lv05, fH, fL, gH, gL)
if nOn
    killInNy(lv15)
    killInNy(lv05)
else
    markTook(lv15)
    markTook(lv05)

// ─────────────────── TJEK ALLE NIVEAUER ───────────────────
// Ny dag: begge sider starter forfra
var Side sideHi = newSide()
var Side sideLo = newSide()
var array<Arm> arms = array.new<Arm>()
var int vDay = na
if inWin and nz(vDay, -1) != dNow
    vDay   := dNow
    sideHi := newSide()
    sideLo := newSide()
    array.clear(arms)

Hit hit = Hit.new()

mrgOK(bool ma, bool mb) =>
    not (mergeEither ? (ma or mb) : (ma and mb))

if useNy and not nOn
    check(ny.hi, ny.aHi, ny.bHi, true,  "NY PRE", hit, sideHi)
    check(ny.lo, ny.aLo, ny.bLo, false, "NY PRE", hit, sideLo)
if useLon and not lOn
    if mrgOK(lon.maHi, lon.mbHi)
        check(lon.hi, lon.aHi, lon.bHi, true,  "London", hit, sideHi)
    if mrgOK(lon.maLo, lon.mbLo)
        check(lon.lo, lon.aLo, lon.bLo, false, "London", hit, sideLo)
if useAsia and not aOn
    if mrgOK(asia.maHi, asia.mbHi)
        check(asia.hi, asia.aHi, asia.bHi, true,  "Asia", hit, sideHi)
    if mrgOK(asia.maLo, asia.mbLo)
        check(asia.lo, asia.aLo, asia.bLo, false, "Asia", hit, sideLo)
// NY PRE 15m-niveauer (de der var uroerte paa begge ved open), til 15:31
if use15 and not nOn and tMin < m15H * 60 + m15M and array.size(lv15) > 0
    for i = 0 to array.size(lv15) - 1
        Lv m = array.get(lv15, i)
        // NY PRE's eget high/low er allerede tjekket ovenfor
        bool isExt = m.isHi ? math.abs(m.a - nz(ny.aHi)) < tickHalf : math.abs(m.a - nz(ny.aLo)) < tickHalf
        if not m.dead and not isExt
            check(m.st, m.a, m.b, m.isHi, "15m", hit, m.isHi ? sideHi : sideLo)

// Minuttet hvor chartet sidst tog et session high / low i vinduet
var int sHiM = na
var int sLoM = na
var float sHiMx = na
var float sLoMn = na
// ... tidligere i minuttet, FOER denne bar (entry-candlen selv taeller ikke)
float sHiPrev = not na(sHiM) and sHiM == minB ? sHiMx : na
float sLoPrev = not na(sLoM) and sLoM == minB ? sLoMn : na
if hit.sHi
    sHiMx := nz(sHiM, -1) != minB ? hit.sHiV : math.max(sHiMx, hit.sHiV)
    sHiM  := minB
if hit.sLo
    sLoMn := nz(sLoM, -1) != minB ? hit.sLoV : math.min(sLoMn, hit.sLoV)
    sLoM  := minB

// ═════════════ EQ (til BE) - samme regler som EQ-indikatoren ═════════════
eqBar() =>
    [open[1], high[1], low[1], close[1], time[1]]

[oS, hS, lS, cS, tS] = request.security(syminfo.tickerid, "1", eqBar(), lookahead = barmerge.lookahead_on)
bool  sameTF = timeframe.in_seconds() == 60
float o1 = sameTF ? open  : oS
float h1 = sameTF ? high  : hS
float l1 = sameTF ? low   : lS
float c1 = sameTF ? close : cS
int   t1 = sameTF ? time  : tS

var int lastT1 = na
bool t1Chg = not na(t1) and t1 != nz(lastT1, -1)
if t1Chg
    lastT1 := t1
bool new1m = sameTF ? barstate.isconfirmed : t1Chg

float own   = na(h1) or na(l1) ? na : (h1 + l1) / 2
// En candle der startede foer open (15:29) giver ikke en ny EQ efter open
int   t1m   = na(t1) ? na : hour(t1, tz) * 60 + minute(t1, tz)
bool  preC  = inWin and not na(t1m) and t1m < winS
bool  bearE = new1m and not preC and not na(c1) and c1 < o1 and c1 < own
bool  bullE = new1m and not preC and not na(c1) and c1 > o1 and c1 > own

// Bearish EQ: anker = high, vokser ned
var float dLastMid = na     // EQ-linjen paa den sidst brugte bearish EQ
var float uLastMid = na     // EQ-linjen paa den sidst brugte bullish EQ
var float dTop = na
var float dBot = na
var bool  dAct = false
var int   dHitM = na        // minuttet hvor en bearish EQ sidst blev ramt
var int   uHitM = na        // minuttet hvor en bullish EQ sidst blev ramt
var float dHitMx = na       // hoejeste bearish EQ ramt i minuttet
var float uHitMn = na       // laveste bullish EQ ramt i minuttet
// ... tidligere i minuttet, FOER denne bar
float dHitPrev = not na(dHitM) and dHitM == minB ? dHitMx : na
float uHitPrev = not na(uHitM) and uHitM == minB ? uHitMn : na
// Market open: alle live EQ'er nulstilles (som EQ-indikatoren). EQ'en der stod lige
// foer open er allerede gemt som "EQ foer open".
var bool uAct = false
var int  eqResetDay = na
if inWin and nz(eqResetDay, -1) != dNow
    eqResetDay := dNow
    dAct := false
    uAct := false
if dAct
    // Tjek mod linjen FOER barens egen low flytter den
    float dMid0 = (dTop + dBot) / 2
    if barstate.isconfirmed and high >= dMid0
        dAct := false
        dLastMid := dMid0
        dHitMx := nz(dHitM, -1) != minB ? dMid0 : math.max(dHitMx, dMid0)
        dHitM  := minB
    else
        dBot := math.min(dBot, low)
if bearE and not dAct
    dTop := h1
    dBot := math.min(l1, low)
    dAct := true

// Bullish EQ: anker = low, vokser op
var float uBot = na
var float uTop = na
if uAct
    // Tjek mod linjen FOER barens egen high flytter den
    float uMid0 = (uBot + uTop) / 2
    if barstate.isconfirmed and low <= uMid0
        uAct := false
        uLastMid := uMid0
        uHitMn := nz(uHitM, -1) != minB ? uMid0 : math.min(uHitMn, uMid0)
        uHitM  := minB
    else
        uTop := math.max(uTop, high)
if bullE and not uAct
    uBot := l1
    uTop := math.max(h1, high)
    uAct := true

// EQ foer market open (til BE): kun en EQ der stadig er live. Laases fra 15:30 og
// vokser videre efter open, indtil EQ-linjen rammes (som backtesten).
var float pDT = na     // bearish: top (anker) / bund (vokser ned)
var float pDB = na
var float pUB = na     // bullish: bund (anker) / top (vokser op)
var float pUT = na
// Hvornaar blev EQ'en fra foer open ramt efter open? (minuttet, na = ikke ramt)
// Ramt = brugt op: den kan ikke laengere bruges som BE.
var int preDHitM = na
var int preUHitM = na
var int preDHitT = na
var int preUHitT = na
if tMin < winS
    pDT := dAct ? dTop : na
    pDB := dAct ? dBot : na
    pUB := uAct ? uBot : na
    pUT := uAct ? uTop : na
    preDHitM := na
    preUHitM := na
else
    // Candlens forloeb antages O-L-H-C (groen) / O-H-L-C (roed). Kommer det nye yderpunkt
    // FOER prisen gaar mod linjen, tjekkes mod den flyttede linje - ellers mod den gamle (6/1-26).
    bool gfD = close > open
    bool gfU = close < open
    if na(preDHitM) and not na(pDT)
        if gfD
            pDB := math.min(pDB, low)
        if high >= (pDT + pDB) / 2
            preDHitM := minB
            preDHitT := time
        else if not gfD
            pDB := math.min(pDB, low)
    if na(preUHitM) and not na(pUB)
        if gfU
            pUT := math.max(pUT, high)
        if low <= (pUB + pUT) / 2
            preUHitM := minB
            preUHitT := time
        else if not gfU
            pUT := math.max(pUT, high)
    // 15:29-candlen lukker foer open: dens EQ er ogsaa en 'EQ foer open' (30/3-26),
    // kun hvis der ikke stod en live EQ foer open i samme retning (en EQ der rammes
    // af 15:30-candlen erstattes IKKE - saa er den ramt, 24/2-26).
    if new1m and preC
        if c1 < o1 and c1 < own and na(pDT)
            pDT := h1
            pDB := math.min(l1, low)
            preDHitM := na
        if c1 > o1 and c1 > own and na(pUB)
            pUB := l1
            pUT := math.max(h1, high)
            preUHitM := na
float preDMid = na(pDT) ? na : (pDT + pDB) / 2
float preUMid = na(pUB) ? na : (pUB + pUT) / 2

// Blev EQ'en fra foer open ramt i SAMME minut som entry (foer/paa entry-candlen),
// og ligger den paa profit-siden (eller praktisk talt paa entry)? Saa er
// BE-spottet taget, og tradet er ugyldigt.
preTaken(float eq, int hm, int ht, float px, bool isShort) =>
    float d = na(eq) ? na : (isShort ? px - eq : eq - px)
    // EQ fra foer open: ogsaa ramt AF entry-candlen taeller
    // EQ foer open (BE-siden) ramt i entry-minuttet = altid ugyldig, uanset hvor den ligger ift. entry
    not na(eq) and not na(hm) and hm == minB and d <= beMax


// ═════════════════════ MINUT- OG DAGS-STATUS ═════════════════════
var int  curM    = na
var bool mHi     = false
var bool mLo     = false
var bool mBad    = false
var bool mTraded = false   // der er allerede taget et trade i minuttet
var int  dayTr   = 0       // trades i dag
var bool dayWin  = false   // en trade har vundet i dag
var bool dayHi   = false
var bool dayLo   = false
var int  lastDay = na

bool newDay = inWin and nz(lastDay, -1) != dNow
if newDay
    lastDay := dNow
    dayHi   := false
    dayLo   := false
    dayTr   := 0
    dayWin  := false

// Tegninger fra det aktuelle minut - slettes hvis minuttet bliver ugyldigt
var array<label> minLbls  = array.new<label>()
var array<line>  minLines = array.new<line>()
var array<box>   minBoxes = array.new<box>()

if minB != nz(curM, -1)
    curM := minB
    mHi  := false
    mLo  := false
    mBad := false
    mTraded := false
    array.clear(minLbls)
    array.clear(minLines)
    array.clear(minBoxes)

if inWin
    mHi   := mHi   or hit.swHi
    mLo   := mLo   or hit.swLo
    dayHi := dayHi or hit.swHi
    dayLo := dayLo or hit.swLo

bool justBad = mHi and mLo and not mBad
if justBad
    mBad := true
bool dayBad = dayBlock and dayHi and dayLo

if justBad
    while array.size(minLbls) > 0
        label.delete(array.pop(minLbls))
    while array.size(minLines) > 0
        line.delete(array.pop(minLines))
    while array.size(minBoxes) > 0
        box.delete(array.pop(minBoxes))

// ═════════════════════ BOKS-STATUS ═════════════════════
// Boksen viser altid kun EEN ting: den nyeste haendelse.
var string bxStatus = ""
var color  bxCol    = color.gray
var string bxLvl    = ""
var string bxBE     = ""
var string bxTime   = ""
var int    pendEnd  = na     // "mulighed" udloeber efter dette minut
// Sidste trade i dag - vises igen naar en "mulighed" udloeber
var string tStatus = ""
var color  tCol    = color.gray
var string tLvl    = ""
var string tBE     = ""
var string tTime   = ""
var int    tM      = na

setBox(string st, color c, string lv, string be) =>
    [st, c, lv, be, str.format_time(time, "HH:mm:ss", dispTz)]

if newDay
    bxStatus := ""
    tStatus  := ""
    tM       := na
    pendEnd  := na

// Det ene indeks har taget et niveau -> mulighed for Vergence
if hit.first and not mBad and not dayBad
    [s1, c1x, l1x, b1x, t1x] = setBox("Mulighed for Vergence", color.yellow, hit.firstTx, "")
    bxStatus := s1
    bxCol    := c1x
    bxLvl    := l1x
    bxBE     := b1x
    bxTime   := t1x
    pendEnd  := minB + maxGap

// "Mulighed" udloeb uden at det andet indeks tog niveauet
if not na(pendEnd) and minB > pendEnd
    pendEnd  := na
    bxStatus := tStatus
    bxCol    := tCol
    bxLvl    := tLvl
    bxBE     := tBE
    bxTime   := tTime

// ═════════════════════ AABENT TRADE: BE / SL / TP ═════════════════════
// Naar SL eller TP rammes: BE-linjen stopper dér, og boksen fjernes.
var bool   oLive  = false
var bool   oShort = false
var float  oEntry = na
var float  oSL    = na
var float  oTP    = na
var float  oBE    = na
var bool   oBeHit = false
var int    oT     = na
var int    oM     = na
var int    oBars  = 0
var line   oBeLn  = na
var line   oTpLn  = na
var box    oSlB   = na     // SL-felt
var box    oTpB   = na     // TP-felt
var box    oSlF   = na     // moerkere del af SL-feltet (hvor prisen har vaeret)
var box    oTpF   = na     // moerkere del af TP-feltet
var label  oSlLb  = na     // pris ved SL
var label  oEnLb  = na     // pris ved entry
var label  oTpLb  = na     // pris ved TP
var float  oSL0   = na     // oprindelig SL (til tegningen)
var float  oAdv   = na     // laengst prisen har vaeret mod SL
var float  oFav   = na     // laengst prisen har vaeret mod TP
var string oTime  = ""

// Tradet blev slettet fordi minuttet blev ugyldigt
if oLive and mBad and oM == minB
    oLive := false

if oLive
    // Den moerkere del: fra entry til hvor langt prisen har vaeret i feltet
    oAdv := oShort ? math.max(oAdv, high) : math.min(oAdv, low)
    oFav := oShort ? math.min(oFav, low)  : math.max(oFav, high)
    float advY = oShort ? math.min(oAdv, oSL0) : math.max(oAdv, oSL0)
    float favY = oShort ? math.max(oFav, oTP)  : math.min(oFav, oTP)
    if oShort
        box.set_top(oSlF, math.max(advY, oEntry))
        box.set_bottom(oTpF, math.min(favY, oEntry))
    else
        box.set_bottom(oSlF, math.min(advY, oEntry))
        box.set_top(oTpF, math.max(favY, oEntry))
    bool hitSL = oShort ? high >= oSL : low  <= oSL
    bool hitTP = oShort ? low  <= oTP : high >= oTP
    if hitSL or hitTP
        oLive := false
        if hitTP and not hitSL
            dayWin := true
        line.set_x2(oBeLn, time)
        line.set_x2(oTpLn, time)
        box.set_right(oSlB, time)
        box.set_right(oTpB, time)
        box.set_right(oSlF, time)
        box.set_right(oTpF, time)
        label.set_x(oSlLb, time)
        label.set_x(oEnLb, time)
        label.set_x(oTpLb, time)
        // Viser boksen stadig dette trade -> fjern den
        if bxTime == oTime and (bxStatus == "SHORT" or bxStatus == "LONG")
            bxStatus := ""
        if tTime == oTime
            tStatus := ""
    else
        // BE foerst efter at 2 15s-candles er lukket efter entry
        if not oBeHit and not na(oBE) and oBars >= 2 and (oShort ? low <= oBE : high >= oBE)
            oBeHit := true
            oSL    := oEntry
        // Linjen vokser 1 minut for hvert minut tradet er aabent
        line.set_x2(oBeLn, oT + (beMins + (minB - oM)) * 60000)
        line.set_x2(oTpLn, oT + (beMins + (minB - oM)) * 60000)
        int xr = oT + (beMins + (minB - oM)) * 60000
        box.set_right(oSlB, xr)
        box.set_right(oTpB, xr)
        box.set_right(oSlF, xr)
        box.set_right(oTpF, xr)
        label.set_x(oSlLb, xr)
        label.set_x(oEnLb, xr)
        label.set_x(oTpLb, xr)
        if barstate.isconfirmed
            oBars += 1

// ═════════════════════ TRADE ═════════════════════
var line   mxLn     = na
// Stregen slettes kort efter entry
var line   mxDel    = na
var int    mxDelT   = na
if not na(mxDel) and (barstate.isrealtime ? timenow : time) >= mxDelT
    line.delete(mxDel)
    mxDel := na

bool entLong  = false
bool entShort = false
bool vrgBear  = false
bool vrgBull  = false

// Kun Vergence fra DETTE minut kan give entry
if array.size(arms) > 0
    for i = array.size(arms) - 1 to 0
        if int(array.get(arms, i).t / 60000) != minB
            array.remove(arms, i)
// Ny Vergence paa denne bar (sider afgoeres altid, men arms kun i et gyldigt minut)
Arm nHi = resolve(sideHi, true)
Arm nLo = resolve(sideLo, false)
for nA in array.from(nHi, nLo)
    if not na(nA) and not mBad and not dayBad
        array.push(arms, nA)
        vrgBear := vrgBear or nA.sh
        vrgBull := vrgBull or not nA.sh
        bxStatus := "Vergence - venter paa close"
        bxCol    := color.yellow
        bxLvl    := nA.nm
        bxBE     := ""
        bxTime   := str.format_time(time, "HH:mm:ss", dispTz)
        pendEnd  := minB

// ── MAX SL-STREGEN: 30 points fra minut-candlens top/bund ──
bool anyArm = array.size(arms) > 0
bool aSh    = anyArm ? array.get(arms, 0).sh : false
float mxLvl = aSh ? m1Hi - maxSL : m1Lo + maxSL
if anyArm and showMaxLn and not mBad
    if na(mxLn)
        mxLn := line.new(time, mxLvl, time + mxAhead * 60000, mxLvl, xloc = xloc.bar_time, color = mxCol, width = 3)
        array.push(minLines, mxLn)
    else
        line.set_y1(mxLn, mxLvl)
        line.set_y2(mxLn, mxLvl)
        line.set_x2(mxLn, time + mxAhead * 60000)

// ── FOERSTE 15s-close hvor begge lukker i retningen afgoer hver Vergence ──
bool   vFire = false
bool   vSh   = false
string vTxt  = ""
if anyArm and barstate.isconfirmed and not mBad
    array<Arm> keep = array.new<Arm>()
    for v in arms
        if tidClose > 0 and time - v.t > 15000 * (tidClose - 1)
            bxStatus := "Ingen Vergence - tid close (3. candle)"
            bxCol    := color.gray
            bxBE     := ""
            continue
        bool aD = v.sh ? close < open : close > open
        bool bD = not na(bClose) and not na(bOpen) and (v.sh ? bClose < bOpen : bClose > bOpen)
        if not (aD and bD)
            array.push(keep, v)
            continue
        // tog begge indeks frisk liq i samme minut, skal begge lukke tilbage forbi hver sin
        float va = v.a
        float vb = v.b
        Side  sdv = v.sh ? sideHi : sideLo
        int   am  = int(v.t / 60000)
        if nz(sdv.aFM, -1) == am and nz(sdv.bFM, -1) == am
            va := na(va) ? sdv.aFL : va
            vb := na(vb) ? sdv.bFL : vb
        bool backA = not needBack or na(va) or (v.sh ? close < va : close > va)
        bool backB = not needBack or na(vb) or (not na(bClose) and (v.sh ? bClose < vb : bClose > vb))
        bool slOK  = not blockMax or (v.sh ? m1Hi - close <= maxSL : close - m1Lo <= maxSL)
        if backA and backB and slOK and not vFire
            vFire := true
            vSh   := v.sh
            vTxt  := v.nm + (not na(va) and not na(vb) ? "  (begge)" : not na(va) ? "  (" + aName + ")" : "  (" + bName + ")")
        else if not vFire
            pendEnd  := na
            bxStatus := not (backA and backB) ? "Ingen Vergence - ingen close tilbage" : "Ingen Vergence - SL > " + str.tostring(maxSL, "#")
            bxCol    := color.gray
            bxLvl    := v.nm
            bxBE     := ""
            bxTime   := str.format_time(time, "HH:mm:ss", dispTz)
            if not slOK
                mxLn := na     // stregen bliver staaende, saa man kan se hvorfor
    arms := keep

bool dayDone = (maxDay > 0 and dayTr >= maxDay) or (stopWin and dayWin)
if vFire and (mTraded or dayDone)
    vFire := false
if vFire
    array.clear(arms)
    pendEnd := na
    bool  sh = vSh
    float px = close

    // ── BE: den naermeste kandidat ──
    BeC bc = BeC.new()
    float lo  = sh ? (uAct ? uBot : na) : (dAct ? dBot : na)
    float hi  = sh ? (uAct ? uTop : na) : (dAct ? dTop : na)
    float mid = na(lo) or na(hi) ? na : (lo + hi) / 2
    float qt  = na(lo) or na(hi) ? na : lo + (sh ? 0.75 : 0.25) * (hi - lo)
    if beEq
        tryBE(bc, px, sh, mid, "EQ")
        tryBE(bc, px, sh, qt,  sh ? "0.75" : "0.25")
    if bePre
        if na(preDHitM)
            tryBE(bc, px, sh, preDMid, "EQ foer open")
        if na(preUHitM)
            tryBE(bc, px, sh, preUMid, "EQ foer open")
    if beSess
        if not na(asia.lo)
            tryBEt(bc, px, sh, sh ? asia.aLo : asia.aHi, sh ? "Asia low" : "Asia high", sh ? asia.lo.aTook : asia.hi.aTook)
        if not na(lon.lo)
            tryBEt(bc, px, sh, sh ? lon.aLo : lon.aHi, sh ? "London low" : "London high", sh ? lon.lo.aTook : lon.hi.aTook)
        if not na(ny.lo)
            tryBEt(bc, px, sh, sh ? ny.aLo : ny.aHi, sh ? "NY PRE low" : "NY PRE high", sh ? ny.lo.aTook : ny.hi.aTook)
    if be15 and array.size(lv15) > 0
        for i = 0 to array.size(lv15) - 1
            Lv m = array.get(lv15, i)
            if m.isHi != sh and not m.dead and not m.aTook
                tryBE(bc, px, sh, m.a, sh ? "15m low" : "15m high")
    if be05 and isOpenM and array.size(lv05) > 0
        for i = 0 to array.size(lv05) - 1
            Lv m = array.get(lv05, i)
            if m.isHi != sh and not m.dead and not m.aTook
                tryBE(bc, px, sh, m.a, sh ? "5m low" : "5m high")

    // EQ fra foer open ramt i entry-minuttet -> BE-spottet er taget (endelig afgoerelse)
    // kun EQ'en paa BE-siden: short -> bullish (under), long -> bearish (over)
    if bePre and preInv and (sh ? preTaken(preUMid, preUHitM, preUHitT, px, sh) : preTaken(preDMid, preDHitM, preDHitT, px, sh))
        bc.bad := true
        bc.src := "EQ foer open"
    // Liq i trade-retningen taget i entry-minuttet (foer entry-candlen), paa BE-siden
    bool eqTaken = sh ? (not na(uHitPrev) and px - uHitPrev >= -beMin) : (not na(dHitPrev) and dHitPrev - px >= -beMin)
    bool slTaken = sh ? (not na(sLoPrev) and px - sLoPrev >= -beMin) : (not na(sHiPrev) and sHiPrev - px >= -beMin)
    if eqTaken or slTaken
        bc.bad := true
        bc.src := eqTaken ? (sh ? "bullish EQ" : "bearish EQ") : (sh ? "session low" : "session high")
    if bc.bad
        bxStatus := "Ingen Vergence - BE (" + bc.src + ") allerede ramt"
        bxCol    := color.gray
        bxBE     := ""
        bxTime   := str.format_time(time, "HH:mm:ss", dispTz)
    if not bc.bad
        entShort := sh
        entLong  := not sh
        // ── Lille markering paa chartet ──
        color c = sh ? bearCol : bullCol
        label lb = label.new(time, sh ? high : low, "VRG", xloc = xloc.bar_time,
             style = sh ? label.style_label_down : label.style_label_up,
             color = color.new(c, 10), textcolor = sh ? color.white : color.black, size = size.small)
        label.set_tooltip(lb, (sh ? "SHORT - " : "LONG - ") + vTxt)
        array.push(minLbls, lb)
        line beL = na
        if showBE and not na(bc.v)
            beL := line.new(time, bc.v, time + beMins * 60000, bc.v, xloc = xloc.bar_time,
                 color = beCol, width = 2, style = line.style_dashed)
            array.push(minLines, beL)

        // ── SL / TP ──
        float slX = sh ? math.max(m1Hi, px + minSL) : math.min(m1Lo, px - minSL)
        float tpX = na
        string tpS = "75p"
        // Kandidater: EQ (begge live EQ'er) og session liq som chartet ikke har taget
        array<float>  tc = array.new<float>()
        array<string> tn = array.new<string>()
        if uAct
            array.push(tc, (uBot + uTop) / 2)
            array.push(tn, "EQ")
        if dAct
            array.push(tc, (dBot + dTop) / 2)
            array.push(tn, "EQ")
        for i = 0 to 2
            Sess s  = i == 0 ? asia : (i == 1 ? lon : ny)
            St   st = sh ? s.lo : s.hi
            if not na(st) and not st.aTook
                array.push(tc, sh ? s.aLo : s.aHi)
                array.push(tn, (i == 0 ? "Asia" : (i == 1 ? "London" : "NY PRE")) + (sh ? " low" : " high"))
        if array.size(tc) > 0
            for i = 0 to array.size(tc) - 1
                float cx = array.get(tc, i)
                float d  = na(cx) ? na : (sh ? px - cx : cx - px)
                if not na(d) and d >= tpMin and d <= tpMax and (na(tpX) or d < math.abs(px - tpX))
                    tpX := cx
                    tpS := array.get(tn, i)
        if na(tpX)
            tpX := sh ? px - tpMax : px + tpMax

        line tpL = na
        if showBE and not showPos
            tpL := line.new(time, tpX, time + beMins * 60000, tpX, xloc = xloc.bar_time,
                 color = tpCol, width = 2, style = line.style_dashed)
            array.push(minLines, tpL)

        // Nyt trade afloeser et evt. aabent
        if oLive
            line.set_x2(oBeLn, time)
            line.set_x2(oTpLn, time)
            box.set_right(oSlB, time)
            box.set_right(oTpB, time)
            box.set_right(oSlF, time)
            box.set_right(oTpF, time)
            label.set_x(oSlLb, time)
            label.set_x(oEnLb, time)
            label.set_x(oTpLb, time)
        oLive  := true
        mTraded := true
        dayTr  += 1
        oShort := sh
        oEntry := px
        oSL    := slX
        oTP    := tpX
        oBE    := bc.v
        oBeHit := false
        oT     := time
        oM     := minB
        oBars  := 0
        oBeLn  := beL
        oTpLn  := tpL
        oSL0   := slX
        oAdv   := px
        oFav   := px
        oSlB   := na
        oTpB   := na
        oSlF   := na
        oTpF   := na
        if showBE and showPos
            int xr0 = time + beMins * 60000
            oSlB := box.new(time, math.max(slX, px), xr0, math.min(slX, px), xloc = xloc.bar_time, border_color = color.new(#F23645, 100), bgcolor = posSlCol)
            oTpB := box.new(time, math.max(tpX, px), xr0, math.min(tpX, px), xloc = xloc.bar_time, border_color = color.new(#089981, 100), bgcolor = posTpCol)
            oSlF := box.new(time, px, xr0, px, xloc = xloc.bar_time, border_color = color.new(#F23645, 100), bgcolor = posSlHit)
            oTpF := box.new(time, px, xr0, px, xloc = xloc.bar_time, border_color = color.new(#089981, 100), bgcolor = posTpHit)
            array.push(minBoxes, oSlB)
            array.push(minBoxes, oTpB)
            array.push(minBoxes, oSlF)
            array.push(minBoxes, oTpF)
        oSlLb := na
        oEnLb := na
        oTpLb := na
        if showBE and showPos and showPx
            int xr1 = time + beMins * 60000
            oSlLb := label.new(xr1, slX, str.tostring(slX, format.mintick), xloc = xloc.bar_time, style = label.style_label_left,
                 color = color.new(color.black, 100), textcolor = color.new(#F23645, 0), size = size.small)
            oEnLb := label.new(xr1, px,  str.tostring(px,  format.mintick), xloc = xloc.bar_time, style = label.style_label_left,
                 color = color.new(color.black, 100), textcolor = pxCol, size = size.small)
            oTpLb := label.new(xr1, tpX, str.tostring(tpX, format.mintick), xloc = xloc.bar_time, style = label.style_label_left,
                 color = color.new(color.black, 100), textcolor = color.new(#089981, 0), size = size.small)
            array.push(minLbls, oSlLb)
            array.push(minLbls, oEnLb)
            array.push(minLbls, oTpLb)
        oTime  := str.format_time(time, "HH:mm:ss", dispTz)
        mxDel  := mxLn     // slettes paa naeste candle
        mxDelT := time_close + mxKeepS * 1000
        mxLn   := na

        // ── Boksen ──
        bxStatus := sh ? "SHORT" : "LONG"
        bxCol    := c
        bxLvl    := vTxt
        bxBE     := not showBE ? "" : (na(bc.v) ? "-" : bc.src) + "    TP: " + tpS
        bxTime   := str.format_time(time, "HH:mm:ss", dispTz)
        tStatus  := bxStatus
        tCol     := bxCol
        tLvl     := bxLvl
        tBE      := bxBE
        tTime    := bxTime
        tM       := minB

// Minuttet er gaaet uden et close -> intet trade
if not anyArm and not na(mxLn)
    line.delete(mxLn)
    mxLn := na

// Minuttet blev ugyldigt -> slet alt fra minuttet
if justBad or (dayBad and anyArm)
    array.clear(arms)
    pendEnd := na
    if tM == minB
        tStatus := ""
        tM      := na
    bxStatus := "Ugyldig - begge sider taget"
    bxCol    := color.gray
    bxLvl    := ""
    bxBE     := ""

// ═════════════════════ BOKSEN I HJOERNET ═════════════════════
var table bx = table.new(boxPos, 2, 3, bgcolor = color.new(color.black, 20), border_width = 1)
if barstate.islast
    table.clear(bx, 0, 0, 1, 2)
    if bxStatus != ""
        table.cell(bx, 0, 0, "VRG  " + bxStatus, text_color = bxCol, text_size = boxSize)
        table.cell(bx, 1, 0, bxTime, text_color = color.gray, text_size = boxSize)
        if bxLvl != ""
            table.cell(bx, 0, 1, "Swept", text_color = color.gray,  text_size = boxSize)
            table.cell(bx, 1, 1, bxLvl,   text_color = color.white, text_size = boxSize)
        if bxBE != ""
            table.cell(bx, 0, 2, "BE / TP",  text_color = color.gray, text_size = boxSize)
            table.cell(bx, 1, 2, bxBE,  text_color = beCol,      text_size = boxSize)

alertcondition(hit.first and not mBad, "Mulighed for Vergence", "Mulighed for Vergence - det ene indeks har taget et niveau")
alertcondition(vrgBear,  "Bearish Vergence", "Bearish Vergence - begge indeks tog session-high")
alertcondition(vrgBull,  "Bullish Vergence", "Bullish Vergence - begge indeks tog session-low")
alertcondition(entLong,  "Vergence LONG",    "Vergence long entry")
alertcondition(entShort, "Vergence SHORT",   "Vergence short entry")

var label tfWarn = na
if warn15s and barstate.islast
    label.delete(tfWarn)
    tfWarn := timeframe.in_seconds() != 15 ? label.new(bar_index, high,
         "Laeg chartet paa 15s - entry laeses paa 15s-candles",
         color = color.orange, textcolor = color.black, style = label.style_label_down, size = size.small) : na
