//@version=6
// =====================================================================
//  Session Levels  (v6)
//  ---------------------------------------------------------------
//  NYT I v6
//    - 5m highs/lows fra NY PRE vises nu OGSAA her (orange), paa samme
//      maade som 15m: live under NY PRE, slettes naar de bliver taget.
//      SMT-indikatoren tegner ikke laengere sine egne niveauer.
//    - 15m-niveauerne er RODE som standard.
//    - Et 5m-niveau paa samme pris som et 15m-niveau vises ikke - saa
//      staar der kun 15m, aldrig 5m og 15m oven i hinanden.
//
//  NYT I v5
//    - De orange 15m-niveauer vises LIVE under NY PRE, ligesom Asia,
//      London og NY PRE. Saa snart en 15m-candle i NY PRE lukker,
//      tegnes dens high og low. Bliver et niveau taget (paa chartets
//      symbol ELLER sammenligningssymbolet), stopper linjen dér.
//      Ved market open staar de uroerte tilbage - der er intet der
//      "hopper op" laengere.
//    - Et 15m-niveau der er lig NY PRE's high/low skjules, saa laenge
//      det er det (den lilla linje viser det allerede).
//    - Taget 15m-niveauer SLETTES, saa kun de aktive staar tilbage.
//      (Kan slaas om til stoppet linje under "Vis taget 15m-niveauer".)
//
//  NYT I v4
//    - Tykkere linjer (default 2) og stoerre, fed tekst ved linjerne.
//      Tekststoerrelse og fed kan vaelges under "Linjer".
//
//  NYT I v3
//    - Det 15m-niveau der ER NY PRE's high eller low springes over.
//      Det er jo allerede tegnet som den lilla NY PRE-linje.
//    - De orange 15m-niveauer er nu en ren MARKET OPEN-ting: de tegnes
//      paa open-baren og slettes igen naar klokken passerer 15:31.
//      (Paa et 15m-chart betyder det at de staar hele 15:30-candlen ud.)
//
//  15m-NIVEAUERNE
//    Hver 15m-candle inde i NY PRE (14:00-15:29) giver et high og et
//    low, som tegnes naar candlen lukker. Bliver et niveau taget MENS
//    NY PRE koerer - paa enten chartets symbol ELLER sammenlignings-
//    symbolet - er det ugyldigt, og linjen stopper. De der stadig staar
//    uroerte paa BEGGE symboler ved market open er dem der gaelder.
//
//  SESSIONER (default, dansk tid)
//      Asia    02:00 - 07:59
//      London  08:00 - 13:59
//      NY PRE  14:00 - 15:29
//
//  SESSIONSLINJERNE
//    Starter paa den candle hvor ekstremet blev sat og loeber til 16:00.
//    Naar sessionen er slut og prisen tager niveauet udefra, stopper
//    linjen dér. High og low stoppes uafhaengigt af hinanden.
//    Der vises dagens og gaarsdagens.
// =====================================================================
indicator("Helbert's Hjælpe Indikator (Session Levels)", overlay = true, max_lines_count = 200, max_labels_count = 200)

// ─────────────────────────── INPUTS ───────────────────────────
g1 = "Sessioner"
// Tider i New York-tid: market open er altid 09:30 NY (14:30 dansk i ugerne i marts og okt/nov
// hvor USA og Europa skifter sommertid paa hver sin dato).
tz       = input.string("America/New_York", "Tidszone (NY)", group = g1)
asiaSess = input.session("2000-0200", "Asia (NY-tid)",   group = g1, tooltip = "= 02:00-08:00 dansk")
lonSess  = input.session("0200-0800", "London (NY-tid)", group = g1, tooltip = "= 08:00-14:00 dansk")
nySess   = input.session("0800-0930", "NY PRE (NY-tid)", group = g1, tooltip = "= 14:00-15:30 dansk")

g2 = "Linjer"
endHour  = input.int(10, "Linjer stopper - time (NY)",  minval = 0, maxval = 23, group = g2)
endMin   = input.int(0,  "Linjer stopper - minut (NY)", minval = 0, maxval = 59, group = g2)
lineW    = input.int(2, "Linjetykkelse", minval = 1, maxval = 4, group = g2)
showLbl  = input.bool(true, "Vis navn ved linjen", group = g2)
lblSizeS = input.string("Normal", "Tekststoerrelse", options = ["Lille", "Normal", "Stor", "Kaempe"], group = g2)
lblBold  = input.bool(true, "Fed tekst", group = g2)

lblSize = switch lblSizeS
    "Lille"  => size.small
    "Stor"   => size.large
    "Kaempe" => size.huge
    => size.normal
lblFmt = lblBold ? text.format_bold : text.format_none

g3 = "Vis / farver"
showAsia = input.bool(true, "Asia",   group = g3, inline = "a")
asiaCol  = input.color(color.red,    "", group = g3, inline = "a")
showLon  = input.bool(true, "London", group = g3, inline = "l")
lonCol   = input.color(color.green,  "", group = g3, inline = "l")
showNy   = input.bool(true, "NY PRE", group = g3, inline = "n")
nyCol    = input.color(color.purple, "", group = g3, inline = "n")

g5 = "NY PRE - 15m / 5m niveauer (market open)"
showM15 = input.bool(true, "Vis 15m highs/lows fra NY PRE", group = g5,
     tooltip = "Tegnes live under NY PRE, naar hver 15m-candle lukker. NY PRE's eget high og low skjules - de er allerede tegnet i lilla.")
showM05 = input.bool(true, "Vis 5m highs/lows fra NY PRE", group = g5,
     tooltip = "Som 15m. Et 5m-niveau paa samme pris som et 15m-niveau vises ikke.")
keepDead = input.bool(false, "Vis taget 15m/5m-niveauer (stoppet linje)", group = g5,
     tooltip = "Fra (standard): et niveau der bliver taget under NY PRE slettes, saa kun de aktive staar tilbage. Til: det bliver staaende som en stoppet linje.")
m15Col  = input.color(color.red,    "Farve 15m", group = g5)
m05Col  = input.color(color.orange, "Farve 5m",  group = g5)
m15TF   = input.timeframe("15", "Timeframe A (15m)", group = g5)
m05TF   = input.timeframe("5",  "Timeframe B (5m)",  group = g5)
cmpSym  = input.symbol("CME_MINI:ES1!", "Sammenlign med (gyldighed)", group = g5,
     tooltip = "Et niveau er kun gyldigt hvis det er uroert paa BEGGE symboler. Ligger du paa NQ, skal denne staa paa ES - og omvendt.")
nyFromH = input.int(8, "NY PRE start - time (NY)",  minval = 0, maxval = 23, group = g5)
nyFromM = input.int(0,  "NY PRE start - minut (NY)", minval = 0, maxval = 59, group = g5)
nyToH   = input.int(9, "Market open - time (NY)",   minval = 0, maxval = 23, group = g5)
nyToM   = input.int(30, "Market open - minut (NY)",  minval = 0, maxval = 59, group = g5)
remH    = input.int(9, "Fjern igen - time (NY)",    minval = 0, maxval = 23, group = g5,
     tooltip = "Niveauerne slettes paa foerste bar fra og med dette klokkeslet. Default 15:31 - altsaa lige efter open-minuttet.")
remM    = input.int(31, "Fjern igen - minut (NY)",   minval = 0, maxval = 59, group = g5)

// ─────────────────────────── TYPER ───────────────────────────
type Sess
    float hi    = na
    float lo    = na
    int   hiT   = na
    int   loT   = na
    int   endT  = na
    int   hiEnd = na
    int   loEnd = na
    bool  hiHit = false
    bool  loHit = false
    line  hiLn  = na
    line  loLn  = na
    label hiLb  = na
    label loLb  = na

// Eet 15m-niveau fra NY PRE. aLvl = chartets symbol, bLvl = det andet.
type M15
    float aLvl = na
    float bLvl = na
    int   t    = na
    bool  isHi = false
    bool  dead = false  // taget mens NY PRE koerte -> ugyldigt
    bool  is15 = true   // 15m (true) eller 5m (false)
    line  ln   = na
    label lb   = na

// ─────────────────────────── FUNKTIONER ───────────────────────────
grow(Sess s, float h, float l, int t) =>
    if h > s.hi
        s.hi  := h
        s.hiT := t
    if l < s.lo
        s.lo  := l
        s.loT := t

checkHit(Sess s, float h, float l, int t) =>
    bool changed = false
    if not s.hiHit and h >= s.hi
        s.hiHit := true
        s.hiEnd := t
        changed := true
    if not s.loHit and l <= s.lo
        s.loHit := true
        s.loEnd := t
        changed := true
    changed

paint(Sess s, color col, string txt) =>
    if not na(s.hi)
        if na(s.hiLn)
            s.hiLn := line.new(s.hiT, s.hi, s.hiEnd, s.hi, xloc = xloc.bar_time, color = col, width = lineW)
            s.loLn := line.new(s.loT, s.lo, s.loEnd, s.lo, xloc = xloc.bar_time, color = col, width = lineW)
            s.hiLb := label.new(s.hiEnd, s.hi, txt, xloc = xloc.bar_time, style = label.style_none, textcolor = col, size = lblSize, text_formatting = lblFmt)
            s.loLb := label.new(s.loEnd, s.lo, txt, xloc = xloc.bar_time, style = label.style_none, textcolor = col, size = lblSize, text_formatting = lblFmt)
        line.set_xy1(s.hiLn, s.hiT,   s.hi)
        line.set_xy2(s.hiLn, s.hiEnd, s.hi)
        line.set_xy1(s.loLn, s.loT,   s.lo)
        line.set_xy2(s.loLn, s.loEnd, s.lo)
        label.set_xy(s.hiLb, s.hiEnd, s.hi)
        label.set_xy(s.loLb, s.loEnd, s.lo)
        label.set_text(s.hiLb, showLbl ? txt : "")
        label.set_text(s.loLb, showLbl ? txt : "")

// ─────────────── HVOR STOPPER DAGENS LINJER? ───────────────
int tMin = hour(time, tz) * 60 + minute(time, tz)
int endM = endHour * 60 + endMin
int endT = time - second(time, tz) * 1000 + (endM - tMin) * 60000

// ─────────────────── ER VI I EN SESSION? ───────────────────
int  aT = time(timeframe.period, asiaSess, tz)
int  lT = time(timeframe.period, lonSess,  tz)
int  nT = time(timeframe.period, nySess,   tz)

bool aOn = not na(aT)
bool lOn = not na(lT)
bool nOn = not na(nT)

bool aStart = aOn and na(aT[1])
bool lStart = lOn and na(lT[1])
bool nStart = nOn and na(nT[1])

// ─────────────────── STATE ───────────────────
var Sess aCur = Sess.new()
var Sess aPrv = Sess.new()
var Sess lCur = Sess.new()
var Sess lPrv = Sess.new()
var Sess nCur = Sess.new()
var Sess nPrv = Sess.new()

// ═══════════════════════════ ASIA ═══════════════════════════
if aStart
    Sess tmp = aPrv
    aPrv := aCur
    aCur := tmp
    aCur.hi    := high
    aCur.lo    := low
    aCur.hiT   := time
    aCur.loT   := time
    aCur.endT  := endT
    aCur.hiEnd := endT
    aCur.loEnd := endT
    aCur.hiHit := false
    aCur.loHit := false
if aOn and not aStart
    grow(aCur, high, low, time)
if showAsia and aOn
    paint(aCur, asiaCol, "Asia")
if showAsia and not aOn and not na(aCur.hi) and time <= aCur.endT
    if checkHit(aCur, high, low, time)
        paint(aCur, asiaCol, "Asia")

// ═══════════════════════════ LONDON ═══════════════════════════
if lStart
    Sess tmp = lPrv
    lPrv := lCur
    lCur := tmp
    lCur.hi    := high
    lCur.lo    := low
    lCur.hiT   := time
    lCur.loT   := time
    lCur.endT  := endT
    lCur.hiEnd := endT
    lCur.loEnd := endT
    lCur.hiHit := false
    lCur.loHit := false
if lOn and not lStart
    grow(lCur, high, low, time)
if showLon and lOn
    paint(lCur, lonCol, "London")
if showLon and not lOn and not na(lCur.hi) and time <= lCur.endT
    if checkHit(lCur, high, low, time)
        paint(lCur, lonCol, "London")

// ═══════════════════════════ NY PRE ═══════════════════════════
if nStart
    Sess tmp = nPrv
    nPrv := nCur
    nCur := tmp
    nCur.hi    := high
    nCur.lo    := low
    nCur.hiT   := time
    nCur.loT   := time
    nCur.endT  := endT
    nCur.hiEnd := endT
    nCur.loEnd := endT
    nCur.hiHit := false
    nCur.loHit := false
if nOn and not nStart
    grow(nCur, high, low, time)
if showNy and nOn
    paint(nCur, nyCol, "NY PRE")
if showNy and not nOn and not na(nCur.hi) and time <= nCur.endT
    if checkHit(nCur, high, low, time)
        paint(nCur, nyCol, "NY PRE")

// ═════════════ NY PRE: 15m + 5m HIGHS OG LOWS ═════════════
m15Bar() =>
    [high[1], low[1], time[1]]

[qH, qL, qT] = request.security(syminfo.tickerid, m15TF, m15Bar(), lookahead = barmerge.lookahead_on)
[eH, eL, eT] = request.security(cmpSym,           m15TF, m15Bar(), lookahead = barmerge.lookahead_on)
[fH, fL, fT] = request.security(syminfo.tickerid, m05TF, m15Bar(), lookahead = barmerge.lookahead_on)
[gH, gL, gT] = request.security(cmpSym,           m05TF, m15Bar(), lookahead = barmerge.lookahead_on)

[cBarH, cBarL] = request.security(cmpSym, timeframe.period, [high, low],
     gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

int  nyFrom  = nyFromH * 60 + nyFromM
int  nyTo    = nyToH   * 60 + nyToM
int  remMin  = remH    * 60 + remM
bool inNy    = tMin >= nyFrom and tMin < nyTo
bool nyBegin = inNy and not inNy[1]
bool m15Gone = tMin >= remMin

// Market open: foerste bar paa dagen fra og med aabningstiden.
var int lastOpenDay = na
int  dNow = dayofmonth(time, tz)
bool isOpenBar = tMin >= nyTo and nz(lastOpenDay, -1) != dNow
if isOpenBar
    lastOpenDay := dNow

// Reager kun een gang pr. 15m- og pr. 5m-candle.
var int lastQt = na
bool newM15 = not na(qT) and qT != nz(lastQt, -1)
if newM15
    lastQt := qT

var int lastFt = na
bool newM05 = not na(fT) and fT != nz(lastFt, -1)
if newM05
    lastFt := fT

// Laa den lukkede candle inde i NY PRE-vinduet?
inNyAt(int t) =>
    int m = na(t) ? na : hour(t, tz) * 60 + minute(t, tz)
    not na(m) and m >= nyFrom and m < nyTo

float tickHalf = syminfo.mintick / 2

var array<M15> m15s = array.new<M15>()

// ── Ny dag: ryd rester ──
if nyBegin and array.size(m15s) > 0
    while array.size(m15s) > 0
        M15 m = array.pop(m15s)
        line.delete(m.ln)
        label.delete(m.lb)

// Tegn eet niveau med det samme, fra candlens start til linjernes slut.
newLvl(float aL, float bL, int t, bool isHi, bool is15, int toT) =>
    color  c   = is15 ? m15Col : m05Col
    M15 m = M15.new()
    m.aLvl := aL
    m.bLvl := bL
    m.t    := t
    m.isHi := isHi
    m.is15 := is15
    m.ln   := line.new(t, aL, toT, aL, xloc = xloc.bar_time, color = c, width = lineW)
    m.lb   := label.new(toT, aL, showLbl ? (is15 ? "15m" : "5m") : "", xloc = xloc.bar_time, style = label.style_none, textcolor = c, size = lblSize, text_formatting = lblFmt)
    m

killLvl(M15 m) =>
    m.dead := true
    line.delete(m.ln)
    label.delete(m.lb)

// Findes der allerede et levende niveau paa samme pris og side?
hasLive(array<M15> arr, float px, bool isHi, bool is15) =>
    bool found = false
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            M15 m = array.get(arr, i)
            if not m.dead and m.isHi == isHi and m.is15 == is15 and math.abs(m.aLvl - px) < tickHalf
                found := true
    found

// Et nyt 15m-niveau fjerner et 5m-niveau paa samme pris (det er det samme high/low).
dropSame5m(array<M15> arr, float px, bool isHi) =>
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            M15 m = array.get(arr, i)
            if not m.dead and not m.is15 and m.isHi == isHi and math.abs(m.aLvl - px) < tickHalf
                killLvl(m)

// ── Ny 15m-candle inde i NY PRE: gem dens high og low og tegn dem ──
if showM15 and newM15 and inNyAt(qT) and not na(qH) and not na(eH)
    dropSame5m(m15s, qH, true)
    dropSame5m(m15s, qL, false)
    array.push(m15s, newLvl(qH, eH, qT, true,  true, endT))
    array.push(m15s, newLvl(qL, eL, qT, false, true, endT))

// ── Ny 5m-candle inde i NY PRE (springes over hvis et 15m staar paa samme pris) ──
if showM05 and newM05 and inNyAt(fT) and not na(fH) and not na(gH)
    if not hasLive(m15s, fH, true, true)
        array.push(m15s, newLvl(fH, gH, fT, true,  false, endT))
    if not hasLive(m15s, fL, false, true)
        array.push(m15s, newLvl(fL, gL, fT, false, false, endT))

// ── Mens NY PRE koerer: taget paa ET af symbolerne = ugyldigt ──
// Linjen stopper dér (eller slettes).
if inNy and array.size(m15s) > 0
    for i = 0 to array.size(m15s) - 1
        M15 m = array.get(m15s, i)
        bool aHit = m.isHi ? high >= m.aLvl : low <= m.aLvl
        bool bHit = m.isHi ? (not na(cBarH) and cBarH >= m.bLvl) : (not na(cBarL) and cBarL <= m.bLvl)
        if not m.dead and (aHit or bHit)
            m.dead := true
            if keepDead
                line.set_x2(m.ln, time)
                label.set_x(m.lb, time)
            else
                line.delete(m.ln)
                label.delete(m.lb)

// ── Skjul det niveau der ER NY PRE's high/low (den lilla linje) ──
if (inNy or isOpenBar) and array.size(m15s) > 0
    for i = 0 to array.size(m15s) - 1
        M15 m = array.get(m15s, i)
        if not m.dead
            bool isExtreme = m.isHi
                 ? (not na(nCur.hi) and math.abs(m.aLvl - nCur.hi) < tickHalf)
                 : (not na(nCur.lo) and math.abs(m.aLvl - nCur.lo) < tickHalf)
            color base = m.is15 ? m15Col : m05Col
            color c    = isExtreme ? color.new(base, 100) : base
            line.set_color(m.ln, c)
            label.set_textcolor(m.lb, c)

// ── 15:31: vaek med dem igen. Det er kun en market open-ting. ──
if m15Gone and array.size(m15s) > 0
    while array.size(m15s) > 0
        M15 m = array.pop(m15s)
        line.delete(m.ln)
        label.delete(m.lb)

// ─────────────── EKSPORT til andre indikatorer ───────────────
plot(aCur.hi, "Asia High",   color = asiaCol, display = display.data_window)
plot(aCur.lo, "Asia Low",    color = asiaCol, display = display.data_window)
plot(lCur.hi, "London High", color = lonCol,  display = display.data_window)
plot(lCur.lo, "London Low",  color = lonCol,  display = display.data_window)
plot(nCur.hi, "NY PRE High", color = nyCol,   display = display.data_window)
plot(nCur.lo, "NY PRE Low",  color = nyCol,   display = display.data_window)
