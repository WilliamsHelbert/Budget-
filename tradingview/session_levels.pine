//@version=6
// =====================================================================
//  Session Levels  (v3)
//  ---------------------------------------------------------------
//  NYT I v3
//    - Det 15m-niveau der ER NY PRE's high eller low springes over.
//      Det er jo allerede tegnet som den lilla NY PRE-linje.
//    - De orange 15m-niveauer er nu en ren MARKET OPEN-ting: de tegnes
//      paa open-baren og slettes igen naar klokken passerer 15:31.
//      (Paa et 15m-chart betyder det at de staar hele 15:30-candlen ud.)
//
//  15m-NIVEAUERNE
//    Hver 15m-candle inde i NY PRE (14:00-15:29) giver et high og et
//    low. Bliver et niveau taget MENS NY PRE koerer - paa enten
//    chartets symbol ELLER sammenligningssymbolet - er det ugyldigt.
//    De der stadig staar uroerte paa BEGGE symboler ved market open
//    tegnes i orange.
//
//  SESSIONER (default, dansk tid)
//      Asia    02:00 - 07:59
//      London  08:00 - 13:59
//      NY PRE  14:00 - 15:29
//
//  SESSIONSLINJERNE
//    Starter paa den candle hvor ekstremet blev sat og loeber til 16:00.
//    Naar sessionen er slut og prisen tager niveauet udefra, stopper
//    linjen dér. High og low stoppes uafhaengigt af hinanden.
//    Der vises dagens og gaarsdagens.
// =====================================================================
indicator("Session Levels", overlay = true, max_lines_count = 200, max_labels_count = 200)

// ─────────────────────────── INPUTS ───────────────────────────
g1 = "Sessioner"
tz       = input.string("Europe/Copenhagen", "Tidszone", group = g1)
asiaSess = input.session("0200-0800", "Asia",   group = g1)
lonSess  = input.session("0800-1400", "London", group = g1)
nySess   = input.session("1400-1530", "NY PRE", group = g1)

g2 = "Linjer"
endHour  = input.int(16, "Linjer stopper - time",  minval = 0, maxval = 23, group = g2)
endMin   = input.int(0,  "Linjer stopper - minut", minval = 0, maxval = 59, group = g2)
lineW    = input.int(1, "Linjetykkelse", minval = 1, maxval = 4, group = g2)
showLbl  = input.bool(true, "Vis navn ved linjen", group = g2)

g3 = "Vis / farver"
showAsia = input.bool(true, "Asia",   group = g3, inline = "a")
asiaCol  = input.color(color.red,    "", group = g3, inline = "a")
showLon  = input.bool(true, "London", group = g3, inline = "l")
lonCol   = input.color(color.green,  "", group = g3, inline = "l")
showNy   = input.bool(true, "NY PRE", group = g3, inline = "n")
nyCol    = input.color(color.purple, "", group = g3, inline = "n")

g5 = "NY PRE - 15m niveauer (market open)"
showM15 = input.bool(true, "Vis 15m highs/lows fra NY PRE", group = g5,
     tooltip = "Kun de niveauer der er uroerte paa BEGGE symboler ved market open. NY PRE's eget high og low springes over - de er allerede tegnet i lilla.")
m15Col  = input.color(color.orange, "Farve", group = g5)
m15TF   = input.timeframe("15", "Timeframe for niveauerne", group = g5)
cmpSym  = input.symbol("CME_MINI:ES1!", "Sammenlign med (gyldighed)", group = g5,
     tooltip = "Et niveau er kun gyldigt hvis det er uroert paa BEGGE symboler. Ligger du paa NQ, skal denne staa paa ES - og omvendt.")
nyFromH = input.int(14, "NY PRE start - time",  minval = 0, maxval = 23, group = g5)
nyFromM = input.int(0,  "NY PRE start - minut", minval = 0, maxval = 59, group = g5)
nyToH   = input.int(15, "Market open - time",   minval = 0, maxval = 23, group = g5)
nyToM   = input.int(30, "Market open - minut",  minval = 0, maxval = 59, group = g5)
remH    = input.int(15, "Fjern igen - time",    minval = 0, maxval = 23, group = g5,
     tooltip = "Niveauerne slettes paa foerste bar fra og med dette klokkeslet. Default 15:31 - altsaa lige efter open-minuttet.")
remM    = input.int(31, "Fjern igen - minut",   minval = 0, maxval = 59, group = g5)

// ─────────────────────────── TYPER ───────────────────────────
type Sess
    float hi    = na
    float lo    = na
    int   hiT   = na
    int   loT   = na
    int   endT  = na
    int   hiEnd = na
    int   loEnd = na
    bool  hiHit = false
    bool  loHit = false
    line  hiLn  = na
    line  loLn  = na
    label hiLb  = na
    label loLb  = na

// Eet 15m-niveau fra NY PRE. aLvl = chartets symbol, bLvl = det andet.
type M15
    float aLvl = na
    float bLvl = na
    int   t    = na
    bool  isHi = false
    bool  dead = false  // taget mens NY PRE koerte -> ugyldigt
    line  ln   = na
    label lb   = na

// ─────────────────────────── FUNKTIONER ───────────────────────────
grow(Sess s, float h, float l, int t) =>
    if h > s.hi
        s.hi  := h
        s.hiT := t
    if l < s.lo
        s.lo  := l
        s.loT := t

checkHit(Sess s, float h, float l, int t) =>
    bool changed = false
    if not s.hiHit and h >= s.hi
        s.hiHit := true
        s.hiEnd := t
        changed := true
    if not s.loHit and l <= s.lo
        s.loHit := true
        s.loEnd := t
        changed := true
    changed

paint(Sess s, color col, string txt) =>
    if not na(s.hi)
        if na(s.hiLn)
            s.hiLn := line.new(s.hiT, s.hi, s.hiEnd, s.hi, xloc = xloc.bar_time, color = col, width = lineW)
            s.loLn := line.new(s.loT, s.lo, s.loEnd, s.lo, xloc = xloc.bar_time, color = col, width = lineW)
            s.hiLb := label.new(s.hiEnd, s.hi, txt, xloc = xloc.bar_time, style = label.style_none, textcolor = col, size = size.small)
            s.loLb := label.new(s.loEnd, s.lo, txt, xloc = xloc.bar_time, style = label.style_none, textcolor = col, size = size.small)
        line.set_xy1(s.hiLn, s.hiT,   s.hi)
        line.set_xy2(s.hiLn, s.hiEnd, s.hi)
        line.set_xy1(s.loLn, s.loT,   s.lo)
        line.set_xy2(s.loLn, s.loEnd, s.lo)
        label.set_xy(s.hiLb, s.hiEnd, s.hi)
        label.set_xy(s.loLb, s.loEnd, s.lo)
        label.set_text(s.hiLb, showLbl ? txt : "")
        label.set_text(s.loLb, showLbl ? txt : "")

// ─────────────── HVOR STOPPER DAGENS LINJER? ───────────────
int tMin = hour(time, tz) * 60 + minute(time, tz)
int endM = endHour * 60 + endMin
int endT = time - second(time, tz) * 1000 + (endM - tMin) * 60000

// ─────────────────── ER VI I EN SESSION? ───────────────────
int  aT = time(timeframe.period, asiaSess, tz)
int  lT = time(timeframe.period, lonSess,  tz)
int  nT = time(timeframe.period, nySess,   tz)

bool aOn = not na(aT)
bool lOn = not na(lT)
bool nOn = not na(nT)

bool aStart = aOn and na(aT[1])
bool lStart = lOn and na(lT[1])
bool nStart = nOn and na(nT[1])

// ─────────────────── STATE ───────────────────
var Sess aCur = Sess.new()
var Sess aPrv = Sess.new()
var Sess lCur = Sess.new()
var Sess lPrv = Sess.new()
var Sess nCur = Sess.new()
var Sess nPrv = Sess.new()

// ═══════════════════════════ ASIA ═══════════════════════════
if aStart
    Sess tmp = aPrv
    aPrv := aCur
    aCur := tmp
    aCur.hi    := high
    aCur.lo    := low
    aCur.hiT   := time
    aCur.loT   := time
    aCur.endT  := endT
    aCur.hiEnd := endT
    aCur.loEnd := endT
    aCur.hiHit := false
    aCur.loHit := false
if aOn and not aStart
    grow(aCur, high, low, time)
if showAsia and aOn
    paint(aCur, asiaCol, "Asia")
if showAsia and not aOn and not na(aCur.hi) and time <= aCur.endT
    if checkHit(aCur, high, low, time)
        paint(aCur, asiaCol, "Asia")

// ═══════════════════════════ LONDON ═══════════════════════════
if lStart
    Sess tmp = lPrv
    lPrv := lCur
    lCur := tmp
    lCur.hi    := high
    lCur.lo    := low
    lCur.hiT   := time
    lCur.loT   := time
    lCur.endT  := endT
    lCur.hiEnd := endT
    lCur.loEnd := endT
    lCur.hiHit := false
    lCur.loHit := false
if lOn and not lStart
    grow(lCur, high, low, time)
if showLon and lOn
    paint(lCur, lonCol, "London")
if showLon and not lOn and not na(lCur.hi) and time <= lCur.endT
    if checkHit(lCur, high, low, time)
        paint(lCur, lonCol, "London")

// ═══════════════════════════ NY PRE ═══════════════════════════
if nStart
    Sess tmp = nPrv
    nPrv := nCur
    nCur := tmp
    nCur.hi    := high
    nCur.lo    := low
    nCur.hiT   := time
    nCur.loT   := time
    nCur.endT  := endT
    nCur.hiEnd := endT
    nCur.loEnd := endT
    nCur.hiHit := false
    nCur.loHit := false
if nOn and not nStart
    grow(nCur, high, low, time)
if showNy and nOn
    paint(nCur, nyCol, "NY PRE")
if showNy and not nOn and not na(nCur.hi) and time <= nCur.endT
    if checkHit(nCur, high, low, time)
        paint(nCur, nyCol, "NY PRE")

// ═════════════ NY PRE: 15m HIGHS OG LOWS (orange) ═════════════
m15Bar() =>
    [high[1], low[1], time[1]]

[qH, qL, qT] = request.security(syminfo.tickerid, m15TF, m15Bar(), lookahead = barmerge.lookahead_on)
[eH, eL, eT] = request.security(cmpSym,           m15TF, m15Bar(), lookahead = barmerge.lookahead_on)

[cBarH, cBarL] = request.security(cmpSym, timeframe.period, [high, low],
     gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

int  nyFrom  = nyFromH * 60 + nyFromM
int  nyTo    = nyToH   * 60 + nyToM
int  remMin  = remH    * 60 + remM
bool inNy    = tMin >= nyFrom and tMin < nyTo
bool nyBegin = inNy and not inNy[1]
bool m15Gone = tMin >= remMin

// Market open: foerste bar paa dagen fra og med aabningstiden.
var int lastOpenDay = na
int  dNow = dayofmonth(time, tz)
bool isOpenBar = tMin >= nyTo and nz(lastOpenDay, -1) != dNow
if isOpenBar
    lastOpenDay := dNow

// Reager kun een gang pr. 15m-candle.
var int lastQt = na
bool newM15 = not na(qT) and qT != nz(lastQt, -1)
if newM15
    lastQt := qT

// Laa den lukkede 15m-candle inde i NY PRE-vinduet?
int  qMin  = na(qT) ? na : hour(qT, tz) * 60 + minute(qT, tz)
bool qInNy = not na(qMin) and qMin >= nyFrom and qMin < nyTo

float tickHalf = syminfo.mintick / 2

var array<M15> m15s = array.new<M15>()

// ── Ny dag: ryd rester ──
if showM15 and nyBegin and array.size(m15s) > 0
    while array.size(m15s) > 0
        M15 m = array.pop(m15s)
        line.delete(m.ln)
        label.delete(m.lb)

// ── Ny 15m-candle inde i NY PRE: gem dens high og low ──
if showM15 and newM15 and qInNy and not na(qH) and not na(eH)
    M15 hiL = M15.new()
    hiL.aLvl := qH
    hiL.bLvl := eH
    hiL.t    := qT
    hiL.isHi := true
    array.push(m15s, hiL)
    M15 loL = M15.new()
    loL.aLvl := qL
    loL.bLvl := eL
    loL.t    := qT
    loL.isHi := false
    array.push(m15s, loL)

// ── Mens NY PRE koerer: taget paa ET af symbolerne = ugyldigt ──
if showM15 and inNy and array.size(m15s) > 0
    for i = 0 to array.size(m15s) - 1
        M15 m = array.get(m15s, i)
        bool aHit = m.isHi ? high >= m.aLvl : low <= m.aLvl
        bool bHit = m.isHi ? (not na(cBarH) and cBarH >= m.bLvl) : (not na(cBarL) and cBarL <= m.bLvl)
        if not m.dead and (aHit or bHit)
            m.dead := true

// ── Market open: tegn dem der overlevede ──
// NY PRE's eget high/low springes over - de er allerede den lilla linje.
if showM15 and isOpenBar and array.size(m15s) > 0
    for i = 0 to array.size(m15s) - 1
        M15 m = array.get(m15s, i)
        bool isExtreme = m.isHi
             ? (not na(nCur.hi) and math.abs(m.aLvl - nCur.hi) < tickHalf)
             : (not na(nCur.lo) and math.abs(m.aLvl - nCur.lo) < tickHalf)
        if not m.dead and not isExtreme
            m.ln := line.new(m.t, m.aLvl, endT, m.aLvl, xloc = xloc.bar_time, color = m15Col, width = lineW)
            m.lb := label.new(endT, m.aLvl, showLbl ? "15m" : "", xloc = xloc.bar_time, style = label.style_none, textcolor = m15Col, size = size.small)

// ── 15:31: vaek med dem igen. Det er kun en market open-ting. ──
if showM15 and m15Gone and array.size(m15s) > 0
    while array.size(m15s) > 0
        M15 m = array.pop(m15s)
        line.delete(m.ln)
        label.delete(m.lb)

// ─────────────── EKSPORT til andre indikatorer ───────────────
plot(aCur.hi, "Asia High",   color = asiaCol, display = display.data_window)
plot(aCur.lo, "Asia Low",    color = asiaCol, display = display.data_window)
plot(lCur.hi, "London High", color = lonCol,  display = display.data_window)
plot(lCur.lo, "London Low",  color = lonCol,  display = display.data_window)
plot(nCur.hi, "NY PRE High", color = nyCol,   display = display.data_window)
plot(nCur.lo, "NY PRE Low",  color = nyCol,   display = display.data_window)
