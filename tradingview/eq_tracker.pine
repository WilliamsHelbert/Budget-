//@version=6
// =====================================================================
//  EQ - Equilibrium Tracker  (v18)
//  ---------------------------------------------------------------
//  NYT I v18
//    - EQ foer open stopper paa den 15s-candle der foerst rammer den
//      (vokser og tjekkes som en normal EQ).
//    - "EQ foer open" tegnes nu som en helt normal EQ (samme bokse,
//      farver og linjer) med labelen "EQ foer open". De lilla linjer
//      kan vaelges igen under "Market open".
//
//  NYT I v17
//    - "EQ foer open": den live bearish og bullish EQ der staar lige
//      foer market open, gemmes ved open i stedet for at blive slettet.
//      Er der ingen live EQ, bruges 15:29-candlens EQ (lukker foer open).
//      Den vises som lilla linjer (0 / 0.25 / EQ / 0.75 / 1) med labelen
//      "EQ foer open" og vokser videre efter open, indtil EQ-linjen rammes.
//      Saa staar den frosset resten af dagen. Bruges som BE-niveau
//      (samme regel som backtesten). Kan slaas fra.
//
//  NYT I v16
//    - En BRUGT (frossen) EQ fjernes, naar prisen har closet helt
//      igennem den - altsaa et close over boksens top eller under dens
//      bund. Den forsvinder 1 minut efter det close (kan aendres).
//      Saa sidder der ikke gamle smaa EQ'er inde mellem candlesne.
//
//  NYT I v15
//    - Kun det kvarter der ligger LAENGST fra ankeret er lysere:
//        Bullish EQ (anker i bunden, vokser op): 0.75-1 (toppen) lys groen
//        Bearish EQ (anker i toppen, vokser ned): 0-0.25 (bunden) lys roed
//      De tre andre kvarter har fuld styrke. Oevre halvdel groen,
//      nedre halvdel roed.
//    - Fede linjer hele vejen paa 0, 0.25, 0.5 (EQ), 0.75 og 1.
//      0 og 0.25 er roede, 0.75 og 1 er groenne, 0.5 er EQ-linjen.
//
//  NYT I v13
//    - Kraftigere boks-farver (premium groen, discount roed).
//    - 0.25- og 0.75-linjerne er fulde linjer i SAMME farve som zonen
//      de ligger i:
//        0.75 (i premium)  -> GROEN
//        0.25 (i discount) -> ROED
//
//  NYT I v11 (ift. v10):
//    - 0.25- og 0.75-linjer i hver EQ-boks (stiplede). Kan slaas fra.
//    - KUN DEN SIDSTE brugte EQ vises, og kun naar der IKKE er en live
//      EQ i samme retning. Bullish og bearish styres hver for sig:
//        * live bearish EQ  -> ingen frossen bearish EQ vises
//        * ingen live bearish -> den senest brugte bearish EQ vises
//      Naar en ny EQ oprettes, slettes den gamle frosne i samme retning.
//
//  NYT I v10 (ift. v9):
//    - OMSKREVET market-open-detektion. v9 byggede et timestamp() for
//      dagens aabning og sammenlignede bar-tider; det ramte ikke.
//      v10 bruger i stedet ur-tid + dagsnummer: foerste bar paa dagen
//      hvor klokken er >= aabningstiden nulstiller. Kan ikke ramme
//      forbi selv om der er huller, weekender eller helligdage.
//    - NYT: synlig markering (blaa baggrund) paa den bar hvor der
//      nulstilles, saa du kan SE om det sker. Kan slaas fra.
//    - RETTET: paa et chart med SAMME timeframe som creationTF laeste
//      request.security den FORRIGE candle, saa EQ'en blev ankret en
//      candle for tidligt og skabt en candle for sent. Nu laeses
//      candlen direkte naar timeframes er ens - korrekt paa baade
//      1m- og 15s-chart.
//
//  OPRETTELSE - bearish EQ, naar en 1m-candle LUKKER og BEGGE gaelder:
//      1) close < open                  -> den lukkede reelt bearish.
//                                          En bullish doji er ugyldig,
//                                          selv om den lukker under midten.
//      2) close < (high + low) / 2      -> den lukkede under sin EGEN EQ.
//    Bullish EQ er spejlvendt: close > open OG close > (high+low)/2.
//    Hver 1m-candle vurderes for sig. Ingen pivots, intet anker fra
//    tidligere candles.
//
//  ANKER       : bearish = den candles high (fast). bullish = dens low.
//  VAEKST      : live / intrabar paa chart-timeframet. Bearish EQ foelger
//                nye lows nedad, bullish nye highs opad, saa EQ-linjen
//                flytter sig. Starter i den udloesende candles egen range.
//  STOP/BRUGT  : paa en bekraeftet luk hvor prisen NAAR EQ-linjen
//                (high >= EQ for bearish, low <= EQ for bullish):
//                EQ'en FRYSER og bliver staaende. Daekker baade
//                RAMT (luk paa rigtig side = din entry) og CLOSET OVER
//                (luk forbi linjen = ugyldig) - i begge tilfaelde BRUGT.
//                Kun den senest brugte bliver staaende (se v11).
//  MARKET OPEN : alt slettes - aktive OG frosne. Dagen starter forfra.
//  Altid max 1 aktiv bearish + 1 aktiv bullish (1 bull + 1 bear samtidig OK).
//
//  Laeg den paa 15s (finest oploesning) eller 1m. Groevere end 1m giver
//  advarsel, for saa bliver vaekst og frysning for grovkornet.
// =====================================================================
indicator("Helbert Hjælpe Indikator (EQ)", overlay = true, max_boxes_count = 500,
     max_lines_count = 500, max_labels_count = 50)

// ─────────────────────────── INPUTS ───────────────────────────
g1 = "Oprettelse (1m candles)"
creationTF = input.timeframe("1", "EQ oprettes paa timeframe", group = g1,
     tooltip = "Hver FAERDIG candle paa dette timeframe testes for sig. En EQ bygges kun af den ene candle - aldrig af en candle foer den.")

g2 = "EQ opfoersel"
useBear   = input.bool(true, "Vis bearish EQ (vokser nedad)", group = g2)
useBull   = input.bool(true, "Vis bullish EQ (vokser opad)",  group = g2)
keepLast  = input.bool(true, "Vis sidste brugte EQ naar ingen er live", group = g2,
     tooltip = "Gaelder hver retning for sig. Er der en live EQ i samme retning, vises den brugte ikke. Slaa fra for aldrig at vise brugte EQ'er.")
killThru  = input.bool(true, "Fjern brugt EQ naar prisen har closet igennem den", group = g2,
     tooltip = "Et close over toppen eller under bunden af en brugt EQ-boks. Den fjernes efter ventetiden nedenfor.")
killMins  = input.int(1, "Ventetid foer den fjernes (minutter)", minval = 0, maxval = 30, group = g2)
warnTF    = input.bool(true, "Advar hvis chartet er groevere end oprettelses-TF", group = g2)

g4 = "Market open"
resetOnOpen    = input.bool(true, "Nulstil ALLE EQ'er ved market open", group = g4,
     tooltip = "Paa dagens foerste bar fra og med aabningstiden slettes baade aktive og frosne EQ'er, og dagen starter helt forfra.")
showPreOpen    = input.bool(true, "Vis EQ'er fra foer market open", group = g4,
     tooltip = "Slaa fra for at holde chartet rent indtil aabningen - saa oprettes der slet ingen EQ'er i timerne foer market open.")
showPreEq      = input.bool(true, "Vis EQ foer open efter open (til BE)", group = g4,
     tooltip = "Den live EQ lige foer open (eller 15:29-candlens EQ) beholdes efter open som lilla linjer og vokser videre, indtil den rammes.")
preNormal      = input.bool(true, "EQ foer open ligner en normal EQ", group = g4,
     tooltip = "Fra = tegnes som lilla linjer i stedet.")
preCol         = input.color(color.purple, "Farve EQ foer open (lilla linjer / label)", group = g4)
showOpenMarker = input.bool(true, "Marker nulstillings-baren (blaa baggrund)", group = g4,
     tooltip = "Farver den bar hvor nulstillingen sker. Slaa fra naar du har bekraeftet at den rammer rigtigt.")
openHour       = input.int(9, "Market open - time (NY)",  minval = 0, maxval = 23, group = g4)
openMin        = input.int(30, "Market open - minut (NY)", minval = 0, maxval = 59, group = g4)
sessTz         = input.string("America/New_York", "Tidszone (NY)", group = g4,
     tooltip = "Tidszonen som klokkeslettet ovenfor laeses i. Europe/Copenhagen 15:30 = dansk aabning. Vaelg America/New_York 09:30 hvis du vil vaere immun over for at DST skifter paa forskellige datoer i EU og USA.")

g3 = "Udseende"
upStrong   = input.color(color.new(color.green, 45), "Groen (oevre halvdel)",            group = g3)
upLight    = input.color(color.new(color.green, 70), "Lys groen (toppen, bullish EQ)",   group = g3)
dnStrong   = input.color(color.new(color.red,   45), "Roed (nedre halvdel)",             group = g3)
dnLight    = input.color(color.new(color.red,   70), "Lys roed (bunden, bearish EQ)",    group = g3)
eqLineCol  = input.color(color.orange, "EQ-linje (0.5)",       group = g3)
upLineCol  = input.color(color.green,  "Linjer 0.75 og 1",     group = g3)
dnLineCol  = input.color(color.red,    "Linjer 0 og 0.25",     group = g3)
showQt     = input.bool(true, "Vis linjerne 0 / 0.25 / 0.75 / 1", group = g3)
qtWidth    = input.int(2, "Tykkelse linjer", minval = 1, maxval = 4, group = g3)

// ───────── OPRETTELSES-CANDLEN (repainter ikke) ─────────
// Paa et FINERE chart end creationTF hentes den 1m-candle der lige er
// LUKKET. lookahead_on + [1] er no-repaint-moenstret: praecis samme
// vaerdier historisk og live, ingen fremtidsdata.
htfBar() =>
    [open[1], high[1], low[1], close[1], time[1]]

[oS, hS, lS, cS, tS] = request.security(syminfo.tickerid, creationTF, htfBar(),
     lookahead = barmerge.lookahead_on)

// Ligger chartet PAA creationTF, ville security() give den forrige candle.
// Saa laeser vi candlen direkte i stedet og handler paa dens egen luk.
bool sameTF = timeframe.in_seconds() == timeframe.in_seconds(creationTF)

float o1 = sameTF ? open  : oS
float h1 = sameTF ? high  : hS
float l1 = sameTF ? low   : lS
float c1 = sameTF ? close : cS
int   t1 = sameTF ? time  : tS

// Reager kun EEN gang pr. oprettelses-candle
var int lastT = na
bool tfChanged = not na(t1) and t1 != nz(lastT, -1)
if tfChanged
    lastT := t1
bool newBar = sameTF ? barstate.isconfirmed : tfChanged

// ───────────────── MARKET OPEN (session-skift) ─────────────────
// Ur-tid i minutter siden midnat, laest i den valgte tidszone.
// Nulstil paa dagens FOERSTE bar hvor klokken er >= aabningstiden.
// Dagsnummeret sikrer at det sker praecis een gang pr. dag, ogsaa naar
// der er huller i data (weekender, helligdage, sen aabning).
int  tMin  = hour(time, sessTz) * 60 + minute(time, sessTz)
int  openM = openHour * 60 + openMin
int  dNow  = dayofmonth(time, sessTz)

var int lastResetDay = na
bool isOpenBar = tMin >= openM and nz(lastResetDay, -1) != dNow
if isOpenBar
    lastResetDay := dNow

bool isPreOpen = tMin < openM
bool canCreate = showPreOpen or not isPreOpen

// Synlig kvittering for at nulstillingen faktisk fyrer
bgcolor(showOpenMarker and resetOnOpen and isOpenBar ? color.new(color.blue, 65) : na, title = "Market open reset")

// ═══════════════════════ TEGNING AF EEN EQ ═══════════════════════
// hi/lo er boksens top og bund. For bearish: hi = anker, lo = nyeste low.
// For bullish: hi = nyeste high, lo = anker.
type EqDraw
    box  b1  = na    // 0    - 0.25  (roed - lys hvis bearish)
    box  b2  = na    // 0.25 - 0.5   (roed)
    box  b3  = na    // 0.5  - 0.75  (groen)
    box  b4  = na    // 0.75 - 1     (groen - lys hvis bullish)
    line l0  = na
    line l25 = na
    line eq  = na
    line l75 = na
    line l1  = na

mkBox(int x1, int x2, float top, float bot, color c) =>
    box.new(x1, top, x2, bot, xloc = xloc.bar_time, border_color = color.new(c, 100), bgcolor = c)

mkLine(int x1, int x2, float y, color c, int w) =>
    line.new(x1, y, x2, y, xloc = xloc.bar_time, color = c, width = w)

setBox(box b, int x2, float top, float bot) =>
    if not na(b)
        box.set_top(b, top)
        box.set_bottom(b, bot)
        box.set_right(b, x2)

setLine(line l, int x1, int x2, float y) =>
    if not na(l)
        line.set_xy1(l, x1, y)
        line.set_xy2(l, x2, y)

// isBull: bullish EQ -> toppen er lys. Bearish -> bunden er lys.
newDraw(int x1, int x2, float hi, float lo, bool isBull) =>
    float rg  = hi - lo
    float p25 = lo + 0.25 * rg
    float p50 = lo + 0.50 * rg
    float p75 = lo + 0.75 * rg
    EqDraw d = EqDraw.new()
    d.b1 := mkBox(x1, x2, p25, lo,  isBull ? dnStrong : dnLight)
    d.b2 := mkBox(x1, x2, p50, p25, dnStrong)
    d.b3 := mkBox(x1, x2, p75, p50, upStrong)
    d.b4 := mkBox(x1, x2, hi,  p75, isBull ? upLight : upStrong)
    d.eq := mkLine(x1, x2, p50, eqLineCol, 2)
    if showQt
        d.l0  := mkLine(x1, x2, lo,  dnLineCol, qtWidth)
        d.l25 := mkLine(x1, x2, p25, dnLineCol, qtWidth)
        d.l75 := mkLine(x1, x2, p75, upLineCol, qtWidth)
        d.l1  := mkLine(x1, x2, hi,  upLineCol, qtWidth)
    d

// EQ foer open: kun linjer (ingen bokse) i een farve + label
newPreDraw(int x1, int x2, float hi, float lo) =>
    float rg = hi - lo
    EqDraw d = EqDraw.new()
    d.l0  := mkLine(x1, x2, lo, preCol, 1)
    d.l25 := mkLine(x1, x2, lo + 0.25 * rg, preCol, 1)
    d.eq  := mkLine(x1, x2, lo + 0.50 * rg, preCol, 3)
    d.l75 := mkLine(x1, x2, lo + 0.75 * rg, preCol, 1)
    d.l1  := mkLine(x1, x2, hi, preCol, 1)
    line.set_style(d.l0,  line.style_dashed)
    line.set_style(d.l25, line.style_dashed)
    line.set_style(d.l75, line.style_dashed)
    line.set_style(d.l1,  line.style_dashed)
    d

updDraw(EqDraw d, int x1, int x2, float hi, float lo) =>
    float rg  = hi - lo
    float p25 = lo + 0.25 * rg
    float p50 = lo + 0.50 * rg
    float p75 = lo + 0.75 * rg
    setBox(d.b1, x2, p25, lo)
    setBox(d.b2, x2, p50, p25)
    setBox(d.b3, x2, p75, p50)
    setBox(d.b4, x2, hi,  p75)
    setLine(d.eq,  x1, x2, p50)
    setLine(d.l0,  x1, x2, lo)
    setLine(d.l25, x1, x2, p25)
    setLine(d.l75, x1, x2, p75)
    setLine(d.l1,  x1, x2, hi)

delDraw(EqDraw d) =>
    if not na(d)
        box.delete(d.b1)
        box.delete(d.b2)
        box.delete(d.b3)
        box.delete(d.b4)
        line.delete(d.l0)
        line.delete(d.l25)
        line.delete(d.eq)
        line.delete(d.l75)
        line.delete(d.l1)

// ═══════════════════════ STATE: BEARISH ═══════════════════════
var float bAnchor  = na     // 1m-candlens high (fast)
var int   bAnchorT = na     // 1m-candlens aabningstid
var float bLow     = na     // nyeste laveste low
var EqDraw bCur    = na     // den live EQ
var EqDraw bLast   = na     // den senest brugte (frosne) EQ
var bool  bActive  = false
var float bLHi     = na     // den brugtes top
var float bLLo     = na     // den brugtes bund
var int   bKillT   = na     // fjernes fra dette tidspunkt

// ═══════════════════════ STATE: BULLISH ═══════════════════════
var float lAnchor  = na     // 1m-candlens low (fast)
var int   lAnchorT = na
var float lHigh    = na     // nyeste hoejeste high
var EqDraw lCur    = na
var EqDraw lLast   = na
var bool  lActive  = false
var float lLHi     = na
var float lLLo     = na
var int   lKillT   = na

// ═══════════════════ STATE: EQ FOER OPEN ═══════════════════
var float  pbHi  = na
var float  pbLo  = na
var int    pbT   = na
var bool   pbOn  = false
var bool   pbNew = false     // lavet af 15:29-candlen paa open-baren
var EqDraw pbD   = na
var label  pbLb  = na
var float  plHi  = na
var float  plLo  = na
var int    plT   = na
var bool   plOn  = false
var bool   plNew = false
var EqDraw plD   = na
var label  plLb  = na

// ═══════════════ NULSTILLING VED MARKET OPEN ═══════════════
// Koeres foerst, saa dagens foerste oprettelses-candle tegner paa et
// helt rent chart. Aktive EQ'er slettes - de fryser IKKE.
// Undtagelse: den live EQ lige foer open gemmes som "EQ foer open".
if resetOnOpen and isOpenBar
    delDraw(pbD)
    delDraw(plD)
    label.delete(pbLb)
    label.delete(plLb)
    pbD  := na
    plD  := na
    pbLb := na
    plLb := na
    pbOn := false
    plOn := false
    pbNew := false
    plNew := false
    if showPreEq and useBear and bActive
        pbHi := bAnchor
        pbLo := bLow
        pbT  := bAnchorT
        pbOn := true
    if showPreEq and useBull and lActive
        plHi := lHigh
        plLo := lAnchor
        plT  := lAnchorT
        plOn := true
    delDraw(bCur)
    delDraw(bLast)
    delDraw(lCur)
    delDraw(lLast)
    bCur    := na
    bLast   := na
    lCur    := na
    lLast   := na
    bActive := false
    lActive := false

// ───────────── OPRETTELSES-CHECK PAA CANDLEN ─────────────
// eq1 = candlens egen equilibrium (50 % af dens samlede range).
float eq1   = na(h1) or na(l1) ? na : (h1 + l1) / 2
bool  valid = newBar and canCreate and not na(o1) and not na(c1) and not na(eq1)

// Bearish: lukkede bearish OG under sin egen EQ.
bool bearTrig = valid and c1 < o1 and c1 < eq1
// Bullish: lukkede bullish OG over sin egen EQ.
bool bullTrig = valid and c1 > o1 and c1 > eq1

// 15:29-candlen lukker foer open: dens EQ bliver "EQ foer open" (hvis der
// ikke allerede er en), og den starter ikke en almindelig live EQ.
// Paa et 1m-chart er 15:29-candlen allerede vurderet paa sin egen bar
// (og gemt ovenfor, hvis den var live) - der er open-barens candle 15:30.
bool open1529 = resetOnOpen and isOpenBar and not sameTF
if open1529 and showPreEq
    if bearTrig and useBear and not pbOn
        pbHi  := h1
        pbLo  := math.min(l1, low)
        pbT   := t1
        pbOn  := true
        pbNew := true
    if bullTrig and useBull and not plOn
        plHi  := math.max(h1, high)
        plLo  := l1
        plT   := t1
        plOn  := true
        plNew := true
if open1529
    bearTrig := false
    bullTrig := false

// EQ foer open: vokser og stopper praecis som en normal EQ - paa den bar
// der rammer EQ-linjen. Saa fryser den resten af dagen.
// En EQ fra 15:29-candlen tjekkes foerst fra naeste bar.
if pbOn
    if na(pbD)
        pbD  := preNormal ? newDraw(pbT, time, pbHi, pbLo, false) : newPreDraw(pbT, time, pbHi, pbLo)
        pbLb := label.new(time, (pbHi + pbLo) / 2, "EQ foer open", xloc = xloc.bar_time,
             color = color.new(preCol, 100), textcolor = preCol, style = label.style_label_left, size = size.small)
    if pbNew
        pbNew := false
    else
        // som en normal EQ: voks med barens low, og stop paa den bar der rammer linjen
        pbLo := math.min(pbLo, low)
        if barstate.isconfirmed and high >= (pbHi + pbLo) / 2
            pbOn := false
    updDraw(pbD, pbT, time, pbHi, pbLo)
    label.set_xy(pbLb, time, (pbHi + pbLo) / 2)
if plOn
    if na(plD)
        plD  := preNormal ? newDraw(plT, time, plHi, plLo, true) : newPreDraw(plT, time, plHi, plLo)
        plLb := label.new(time, (plHi + plLo) / 2, "EQ foer open", xloc = xloc.bar_time,
             color = color.new(preCol, 100), textcolor = preCol, style = label.style_label_left, size = size.small)
    if plNew
        plNew := false
    else
        plHi := math.max(plHi, high)
        if barstate.isconfirmed and low <= (plHi + plLo) / 2
            plOn := false
    updDraw(plD, plT, time, plHi, plLo)
    label.set_xy(plLb, time, (plHi + plLo) / 2)

// ════════════════════════ BEARISH EQ ══════════════════════════
// ── VAEKST + FRYS (koeres FOER oprettelse, saa en ny EQ kan starte
//    paa samme bar hvor den gamle blev brugt) ──
if bActive
    bLow := math.min(bLow, low)
    float eq = (bAnchor + bLow) / 2
    updDraw(bCur, bAnchorT, time, bAnchor, bLow)
    // STOP/BRUGT - kun paa bekraeftet luk, naar prisen naar EQ-linjen.
    // high >= eq daekker baade RAMT (luk under) og CLOSET OVER (luk over).
    // Den brugte afloeser den forrige brugte - kun een frossen pr. retning.
    if barstate.isconfirmed and high >= eq
        delDraw(bLast)
        if keepLast
            bLast  := bCur
            bLHi   := bAnchor
            bLLo   := bLow
            bKillT := na
        else
            delDraw(bCur)
            bLast := na
        bCur    := na
        bActive := false

// ── OPRETTELSE ──
// En ny live EQ skjuler den sidste brugte i samme retning.
if useBear and bearTrig and not bActive
    bAnchor  := h1                      // ankeret er DENNE candles high
    bAnchorT := t1
    bLow     := math.min(l1, low)       // start i candlens egen range
    bActive  := true
    delDraw(bLast)
    bLast    := na
    bCur     := newDraw(bAnchorT, time, bAnchor, bLow, false)

// ════════════════════════ BULLISH EQ ══════════════════════════
// ── VAEKST + FRYS ──
if lActive
    lHigh := math.max(lHigh, high)
    float eq = (lAnchor + lHigh) / 2
    updDraw(lCur, lAnchorT, time, lHigh, lAnchor)
    // low <= eq daekker baade RAMT (luk over) og CLOSET OVER (luk under).
    if barstate.isconfirmed and low <= eq
        delDraw(lLast)
        if keepLast
            lLast  := lCur
            lLHi   := lHigh
            lLLo   := lAnchor
            lKillT := na
        else
            delDraw(lCur)
            lLast := na
        lCur    := na
        lActive := false

// ── OPRETTELSE ──
if useBull and bullTrig and not lActive
    lAnchor  := l1                      // ankeret er DENNE candles low
    lAnchorT := t1
    lHigh    := math.max(h1, high)      // start i candlens egen range
    lActive  := true
    delDraw(lLast)
    lLast    := na
    lCur     := newDraw(lAnchorT, time, lHigh, lAnchor, true)

// ═══════════ BRUGT EQ: FJERN NAAR PRISEN HAR CLOSET IGENNEM ═══════════
if killThru and not na(bLast)
    if na(bKillT) and barstate.isconfirmed and (close > bLHi or close < bLLo)
        bKillT := time + killMins * 60000
    if not na(bKillT) and time >= bKillT
        delDraw(bLast)
        bLast  := na
        bKillT := na
if killThru and not na(lLast)
    if na(lKillT) and barstate.isconfirmed and (close > lLHi or close < lLLo)
        lKillT := time + killMins * 60000
    if not na(lKillT) and time >= lKillT
        delDraw(lLast)
        lLast  := na
        lKillT := na

// ──────── Advarsel hvis chartet er groevere end oprettelses-TF ────────
var label tfLabel = na
if warnTF and barstate.islast
    label.delete(tfLabel)
    tfLabel := timeframe.in_seconds() > timeframe.in_seconds(creationTF) ? label.new(bar_index, high,
         "Chartet er groevere end oprettelses-timeframet - laeg det paa " + creationTF + " eller finere",
         color = color.orange, textcolor = color.black, style = label.style_label_down, size = size.small) : na
